+                };
+                let f = Connection::open(path).await.unwrap();
+                let stock = rusqlite::Connection::open_in_memory().unwrap();
+                f.register_collation_function(CountProbeCollation { fold_ascii: false });
+                f.execute("CREATE TABLE targets(k TEXT COLLATE gh531_cmp, active INTEGER)")
+                    .await
+                    .unwrap();
+                stock
+                    .execute_batch("CREATE TABLE targets(k TEXT, active INTEGER)")
+                    .unwrap();
+                f.execute_batch(ROWS).await.unwrap();
+                stock.execute_batch(ROWS).unwrap();
+                f.set_reject_mem_fallback(true);
+                f.set_strict_mem_fallback_rejection(true);
+                assert_matches(&stock, &f, SQL, &[20, 0]).await;
+                let retained = f.prepare(SQL).await.unwrap();
+
+                // Every stored text key is lowercase, so this replacement
+                // preserves the index's existing order while changing which
+                // upper-case probes match. Its ASCII semantics are exactly
+                // stock NOCASE on this fixture.
+                f.register_collation_function(CountProbeCollation { fold_ascii: true });
+                assert!(matches!(
+                    retained
+                        .query_with_params(&[SqliteValue::Integer(20), SqliteValue::Integer(0)])
+                        .await
+                        .unwrap_err(),
+                    fsqlite_error::FrankenError::SchemaChanged
+                ));
+                for params in [[20, 0], [2, 1], [0, 0]] {
+                    let expected = stock_rows(&stock, FOLDED_ORACLE, &params);
+                    let values: Vec<_> = params.into_iter().map(SqliteValue::Integer).collect();
+                    for rows in [
+                        f.query_with_params(SQL, &values).await.unwrap(),
+                        f.prepare(SQL)
+                            .await
+                            .unwrap()
+                            .query_with_params(&values)
