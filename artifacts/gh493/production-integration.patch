+#[test]
+fn schema_only_cte_runtime_metadata_and_view_roots_match_stock() {
+    const CASES: &[&str] = &[
+        "WITH c(x) AS MATERIALIZED (VALUES (7)) SELECT c.x, (SELECT count(*) FROM sqlite_master WHERE name='c') FROM c",
+        "WITH nodes(id,parent,label) AS MATERIALIZED (SELECT id+100,parent,label FROM main.nodes) SELECT id FROM nodes ORDER BY id",
+        "WITH nodes(id,parent,label) AS MATERIALIZED (SELECT id+100,parent,label FROM main.nodes) SELECT sum(id),count(*) FROM nodes",
+        "WITH nodes(id,parent,label) AS MATERIALIZED (SELECT id+100,parent,label FROM main.nodes) SELECT n.id,b.v FROM nodes n JOIN b ON b.v=n.id-101 WHERE n.id>100 ORDER BY n.id LIMIT 2",
+        "WITH c AS MATERIALIZED (SELECT g,s FROM grouped) SELECT c.g,c.s+b.v FROM c JOIN b ON b.v=2*c.g ORDER BY c.g",
+    ];
+    asupersync::test_utils::run_test(|| async {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("cte-namespace.db");
+        seed(&path);
+        {
+            let stock = rusqlite::Connection::open(&path).unwrap();
+            stock.execute_batch(
+                "CREATE VIEW grouped AS SELECT v%2 AS g,sum(v) AS s FROM a GROUP BY v%2",
+            ).unwrap();
+        }
+        let expected: Vec<_> = CASES.iter().map(|sql| stock_query(&path, sql)).collect();
+        for (sql, expected) in CASES.iter().zip(expected) {
+            let conn = Connection::open_existing_schema_only(
+                path.to_string_lossy().as_ref(),
+            ).await.unwrap();
+            assert_eq!(query(&conn, sql).await, expected, "direct: {sql}");
+            {
+                let prepared = conn.prepare(sql).await.unwrap();
+                for _ in 0..2 {
+                    let rows = prepared.query_with_params(&[]).await.unwrap();
+                    let values: Vec<_> = rows.iter().map(|row| row.values().to_vec()).collect();
+                    assert_eq!(values, expected, "prepared: {sql}");
+                    assert_bounded(&conn, sql);
+                }
+            }
+            assert_bounded(&conn, sql);
+            conn.close_without_checkpoint().await.unwrap();
+        }
+    });
+}
