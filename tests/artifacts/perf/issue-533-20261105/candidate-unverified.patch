+    #[derive(Clone, Copy, Default)]
+    struct CallbackState {
+        connects: usize,
+        best_indexes: usize,
+        filters: usize,
+        nexts: usize,
+        cursor_drops: usize,
+        disconnects: usize,
+        value_offset: i64,
+        bad_index: bool,
+        fail_column: bool,
+        fail_disconnect: bool,
+        disconnect_before_cursor_drop: bool,
+    }
+
+    thread_local! {
+        static CALLBACKS: Cell<CallbackState> = Cell::new(CallbackState::default());
+    }
+
+    fn update_callbacks(update: impl FnOnce(&mut CallbackState)) {
+        CALLBACKS.with(|state| {
+            let mut value = state.get();
+            update(&mut value);
+            state.set(value);
+        });
+    }
+
+    struct CountingSeriesTable(GenerateSeriesTable);
+    struct CountingSeriesCursor(GenerateSeriesCursor);
+
+    impl VirtualTable for CountingSeriesTable {
+        type Cursor = CountingSeriesCursor;
+
+        fn column_info(args: &[&str]) -> Vec<(String, char)> {
+            GenerateSeriesTable::column_info(args)
+        }
+
+        fn connect(cx: &Cx, args: &[&str]) -> Result<Self> {
+            update_callbacks(|state| state.connects += 1);
+            GenerateSeriesTable::connect(cx, args).map(Self)
+        }
+
+        fn best_index(&self, info: &mut IndexInfo) -> Result<()> {
+            update_callbacks(|state| state.best_indexes += 1);
+            self.0.best_index(info)?;
+            if CALLBACKS.with(Cell::get).bad_index {
+                info.constraint_usage[0].argv_index = 99;
+            }
+            Ok(())
+        }
+
+        fn open(&self) -> Result<Self::Cursor> {
+            self.0.open().map(CountingSeriesCursor)
+        }
+
+        fn disconnect(&mut self, _cx: &Cx) -> Result<()> {
+            update_callbacks(|state| {
+                state.disconnect_before_cursor_drop |= state.cursor_drops < state.filters;
+                state.disconnects += 1;
+            });
+            if CALLBACKS.with(Cell::get).fail_disconnect {
+                return Err(FrankenError::FunctionError(
+                    "test disconnect failure".to_owned(),
+                ));
+            }
+            Ok(())
+        }
+    }
+
+    impl VirtualTableCursor for CountingSeriesCursor {
+        fn filter(
+            &mut self,
+            cx: &Cx,
+            index: i32,
+            name: Option<&str>,
+            args: &[SqliteValue],
+        ) -> Result<()> {
+            update_callbacks(|state| state.filters += 1);
+            self.0.filter(cx, index, name, args)
+        }
+
+        fn next(&mut self, cx: &Cx) -> Result<()> {
+            update_callbacks(|state| state.nexts += 1);
+            self.0.next(cx)
+        }
+
+        fn eof(&self) -> bool {
+            self.0.eof()
+        }
+
+        fn column(&self, ctx: &mut ColumnContext, column: i32) -> Result<()> {
+            let state = CALLBACKS.with(Cell::get);
+            if state.fail_column {
+                return Err(FrankenError::FunctionError(
+                    "test column failure".to_owned(),
+                ));
+            }
+            self.0.column(ctx, column)?;
+            if column == 0 && state.value_offset != 0 {
+                let value = ctx.take_value().unwrap().to_integer() + state.value_offset;
+                ctx.set_value(SqliteValue::Integer(value));
+            }
+            Ok(())
+        }
+
+        fn rowid(&self) -> Result<i64> {
+            self.0.rowid()
+        }
+    }
+
+    impl Drop for CountingSeriesCursor {
+        fn drop(&mut self) {
+            update_callbacks(|state| state.cursor_drops += 1);
+        }
+    }
