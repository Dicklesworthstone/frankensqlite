+        calls.store(0, Ordering::SeqCst);
+        assert_eq!(
+            frank(
+                &conn,
+                "WITH t AS (SELECT value FROM generate_series(1,4)) SELECT sum(abs(-value)) FROM t"
+            )
+            .await
+            .unwrap(),
+            vec![vec!["int:-10".to_owned()]],
