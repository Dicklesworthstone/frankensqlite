+                        SqliteValue::Null,
+                        SqliteValue::Null,
+                    ],
+                ),
+                ([1, 3, 0, 0], vec![3.into(), 6.into(), 1.into(), 3.into()]),
+            ] {
+                let params = bounds.map(SqliteValue::Integer);
+                for prepared_api in [false, true] {
+                    conn.reset_fallback_decision_evidence();
+                    let rows = if prepared_api {
+                        prepared.query_with_params(&params).await.unwrap()
+                    } else {
+                        conn.query_with_params(sql, &params).await.unwrap()
+                    };
+                    assert_eq!(rows.len(), 1, "{bounds:?}");
+                    assert_eq!(
+                        rows[0].values(),
+                        expected,
+                        "prepared={prepared_api}, {bounds:?}"
+                    );
+                    assert!(
+                        !used_cte_materialization(&conn),
+                        "prepared={prepared_api}, {bounds:?}"
+                    );
+                }
+            }
+        }
+        assert_eq!(
+            frank(&conn, "WITH t(v,lo,hi,delta) AS (SELECT value,start,stop,step FROM generate_series(2,8,2)) SELECT count(v),min(lo),max(hi),sum(delta) FROM t").await.unwrap(),
+            vec![vec!["int:4".to_owned(), "int:2".to_owned(), "int:8".to_owned(), "int:8".to_owned()]],
+        );
+        {
+            let prepared = conn.prepare(
+                "WITH t(first,second) AS (SELECT value,value FROM generate_series(1,2)) SELECT t.* FROM t"
+            ).await.unwrap();
+            assert_eq!(
+                prepared.column_names(),
+                vec!["first".to_owned(), "second".to_owned()]
+            );
+            let rows = prepared.query().await.unwrap();
+            assert_eq!(rows[0].values(), &[1.into(), 1.into()]);
+            assert_eq!(rows[1].values(), &[2.into(), 2.into()]);
+        }
+        for sql in [
+            "WITH t AS (SELECT value FROM generate_series(1,5)) SELECT count(start) FROM t",
+            "WITH t AS (SELECT * FROM generate_series(1,5)) SELECT count(start) FROM t",
+        ] {
+            assert!(
+                frank(&conn, sql).await.is_err(),
+                "hidden column escaped its projection: {sql}"
+            );
+        }
+        for source in ["generate_series()", "generate_series(1,2,3,4)"] {
+            for hint in ["", "MATERIALIZED"] {
+                let sql =
+                    format!("WITH t AS {hint} (SELECT value FROM {source}) SELECT count(*) FROM t");
+                assert!(
+                    frank(&conn, &sql).await.is_err(),
+                    "invalid arguments accepted: {sql}"
+                );
+            }
+        }
+        conn.execute("CREATE TABLE out(n)").await.unwrap();
+        for sql in [
+            "INSERT INTO out WITH t AS (SELECT value FROM generate_series(1,8)) SELECT count(*) FROM t LIMIT 0",
+            "INSERT INTO out WITH t AS (SELECT value FROM generate_series(1,8)) SELECT count(*) FROM t LIMIT 1 OFFSET 1",
+            "WITH t AS (SELECT value FROM generate_series(1,8)) INSERT INTO out SELECT count(*) FROM t LIMIT 0",
+        ] {
+            assert_eq!(conn.execute(sql).await.unwrap(), 0, "{sql}");
+        }
+        assert_eq!(
+            frank(&conn, "SELECT count(*) FROM out").await.unwrap(),
+            vec![vec!["int:0".to_owned()]]
+        );
+        conn.execute("INSERT INTO out WITH t AS (SELECT value FROM generate_series(1,8)) SELECT count(*) FROM t").await.unwrap();
+        assert_eq!(
+            frank(&conn, "SELECT n FROM out").await.unwrap(),
+            vec![vec!["int:8".to_owned()]]
+        );
+        conn.close().await.unwrap();
