+                        "us_per_query":elapsed.as_secs_f64()*1_000_000.0/iterations as f64,
+                    }));
+                }
+            }
+            println!(
+                "{}",
+                serde_json::json!({"case":case.name,"sql":case.sql,"params":case.params,"samples":samples})
+            );
+        }
+        f.close().await.unwrap();
+        for path in [&stock_path, &franken_path] {
+            let check = rusqlite::Connection::open(path).unwrap();
+            let integrity: String = check
+                .query_row("PRAGMA integrity_check", [], |row| row.get(0))
+                .unwrap();
+            assert_eq!(integrity, "ok");
+        }
+    });
