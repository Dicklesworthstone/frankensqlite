+fn single_use_ctes_preserve_volatile_callbacks_and_function_replacements() {
+    asupersync::test_utils::run_test(|| async {
+        let conn = Connection::open(":memory:").await.unwrap();
+        let calls = Arc::new(AtomicUsize::new(0));
+        conn.register_nondeterministic_scalar_function(CteCallCounter {
+            name: "cte_probe",
+            calls: Arc::clone(&calls),
+        });
+        for hint in ["", "MATERIALIZED"] {
+            for (body, consumer, expected, expected_calls) in [
+                (
+                    "SELECT value FROM generate_series(1,cte_probe(4))",
+                    "SELECT count(*) FROM t",
+                    vec!["int:4".to_owned()],
+                    1,
+                ),
+                (
+                    "SELECT cte_probe(value) AS v FROM generate_series(1,4)",
+                    "SELECT sum(v),sum(v) FROM t",
+                    vec!["int:10".to_owned(), "int:10".to_owned()],
+                    4,
+                ),
+                (
+                    "SELECT cte_probe(value) AS v FROM generate_series(1,4)",
+                    "SELECT sum(a.v+b.v) FROM t a,t b",
+                    vec!["int:80".to_owned()],
+                    4,
+                ),
+                (
+                    "SELECT value FROM generate_series(1,4)",
+                    "SELECT count(*) FROM t WHERE cte_probe(value)>2",
+                    vec!["int:2".to_owned()],
+                    4,
+                ),
+            ] {
+                let sql = format!("WITH t AS {hint} ({body}) {consumer}");
+                calls.store(0, Ordering::SeqCst);
+                conn.reset_fallback_decision_evidence();
+                assert_eq!(frank(&conn, &sql).await.unwrap(), vec![expected], "{sql}");
+                assert_eq!(calls.load(Ordering::SeqCst), expected_calls, "{sql}");
+                assert!(used_cte_materialization(&conn), "{sql}");
+            }
+        }
+        conn.register_nondeterministic_scalar_function(CteCallCounter {
+            name: "abs",
+            calls: Arc::clone(&calls),
