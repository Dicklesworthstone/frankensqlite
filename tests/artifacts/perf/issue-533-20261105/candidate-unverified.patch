+    #[test]
+    fn gh533_planned_exists_cursor_closes_before_disconnect_on_match_and_errors() {
+        asupersync::test_utils::run_test(|| async {
+            let conn = Connection::open(":memory:").await.unwrap();
+            let query =
+                select("SELECT 1 FROM generate_series(1,100) s WHERE s.value>=50 AND s.value%2=0");
+            let SelectCore::Select { where_clause, .. } = &query.body.select else {
+                unreachable!()
+            };
+            let col_map = conn.build_join_col_map(&query);
+            let context = JoinEvalCollationContext {
+                declared_json_keys: conn.build_join_declared_blob_columns(&query),
+                column_collations: conn.build_join_col_collations(&query),
+                column_affinities: conn.build_join_col_affinities(&query),
+                using_column_projections: HashMap::new(),
+                registry: lock_unpoisoned(conn.collation_registry.as_ref()).clone(),
+            };
+            let _context_guard = JoinEvalCollationContextGuard::push(context.clone());
+            let factory: Arc<dyn VtabModuleFactory> =
+                Arc::new(module_factory_from::<CountingSeriesTable>());
+            for (fail_column, fail_disconnect, bad_index) in [
+                (false, false, false),
+                (true, false, false),
+                (false, true, false),
+                (true, true, false),
+                (false, false, true),
+            ] {
+                CALLBACKS.with(|state| {
+                    state.set(CallbackState {
+                        fail_column,
+                        fail_disconnect,
+                        bad_index,
+                        ..Default::default()
+                    })
+                });
+                let result = conn.run_table_function_exists_probe(
+                    "generate_series",
+                    &factory,
+                    &[SqliteValue::Integer(1), SqliteValue::Integer(100)],
+                    &[1, 2],
+                    where_clause.as_deref(),
+                    &col_map,
+                    &context,
+                    &vec![true; col_map.len()],
+                );
+                if fail_column || fail_disconnect || bad_index {
+                    let message = result.unwrap_err().to_string();
+                    if fail_column {
+                        assert!(message.contains("test column failure"), "{message}");
+                    }
+                    if fail_disconnect {
+                        assert!(message.contains("test disconnect failure"), "{message}");
+                    }
+                    if bad_index {
+                        assert!(message.contains("xBestIndex malfunction"), "{message}");
+                    }
+                } else {
+                    assert!(result.unwrap());
+                }
+                let callbacks = CALLBACKS.with(Cell::get);
+                assert_eq!(callbacks.connects, 1);
+                assert_eq!(callbacks.best_indexes, 1);
+                assert_eq!(
+                    callbacks.nexts, 0,
+                    "a match/error does not advance the cursor"
+                );
+                assert_eq!(callbacks.cursor_drops, usize::from(!bad_index));
+                assert_eq!(callbacks.disconnects, 1);
+                assert!(!callbacks.disconnect_before_cursor_drop);
+                assert_eq!(conn.live_vtab_callback_depth.get(), 0);
+            }
+        });
+    }
