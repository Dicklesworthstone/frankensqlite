+/// GH#531: ordering the outer source must not truncate it before the join.
+/// Missing INNER matches, duplicate index matches, LEFT null extension, and
+/// WHERE filtering all change how many outer rows satisfy LIMIT/OFFSET.
+#[test]
+fn ordered_lookup_join_limits_match_stock() {
+    let _serial = serial();
+    asupersync::test_utils::run_test(|| async {
+        for file_backed in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let (f, r) = open_pair(file_backed, &dir).await;
+            let indexes = "CREATE INDEX t_v_id ON t(v DESC, id DESC);\
+                           CREATE INDEX t_n_id ON t(n ASC, id DESC);";
+            f.execute_batch(indexes).await.unwrap();
+            r.execute_batch(indexes).unwrap();
+            let queries = [
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g ORDER BY t.v DESC, t.id DESC",
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g ORDER BY t.v ASC, t.id ASC",
+                "SELECT t.id, k.label FROM t LEFT JOIN k ON t.g = k.g ORDER BY t.v DESC, t.id DESC",
+                "SELECT t.id, k.label FROM t LEFT JOIN k ON t.g = k.g AND k.g > 2 \
+                 ORDER BY t.v DESC, t.id DESC",
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g \
+                 WHERE t.n > 1 AND k.label <> 'k3' ORDER BY t.v DESC, t.id DESC",
+                "SELECT a.id, b.label FROM t AS a LEFT JOIN k AS b ON b.g = a.g \
+                 WHERE b.label IS NULL ORDER BY a.n ASC, a.id DESC",
+                "SELECT a.id, b.label FROM t AS a JOIN k AS b ON b.g = a.g ORDER BY a.id DESC",
+                "SELECT t.id, u.w FROM t LEFT JOIN u ON u.tid = t.id ORDER BY t.id DESC",
+                "SELECT t.id, u.w FROM t JOIN u ON u.tid = t.id ORDER BY t.v DESC, t.id DESC",
+                "SELECT t.v AS sort_key, t.id, k.label FROM t JOIN k ON t.g = k.g \
+                 ORDER BY sort_key DESC, 2 DESC",
+                "SELECT t.id, k.label FROM t INDEXED BY t_v_id JOIN k ON t.g = k.g \
+                 ORDER BY t.v DESC, t.id DESC",
+                // These orderings cannot stream from the outer index and retain the sorter.
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g ORDER BY k.label, t.id DESC",
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g \
+                 ORDER BY t.v COLLATE NOCASE DESC, t.id DESC",
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g \
+                 ORDER BY t.v DESC NULLS FIRST, t.id DESC",
+                "SELECT t.id, k.label FROM t JOIN k ON t.g = k.g \
+                 WHERE t.id = 7 ORDER BY k.label, t.id DESC",
+            ];
+            for prefix in queries {
+                let sql = format!("{prefix} LIMIT ?1 OFFSET ?2");
+                let prepared = f.prepare(&sql).await.unwrap();
+                for params in [[1, 0], [5, 2], [0, 0], [-1, 30], [7, 100], [3, -2]] {
+                    let expected = rq(&r, &sql, &params).unwrap();
+                    let values = params.map(SqliteValue::Integer);
+                    let adhoc = f.query_with_params(&sql, &values).await.unwrap();
+                    let reused = prepared.query_with_params(&values).await.unwrap();
+                    assert_eq!(tag_rows(&adhoc), expected, "{sql} {params:?}, file={file_backed}");
+                    assert_eq!(tag_rows(&reused), expected, "prepared {sql} {params:?}, file={file_backed}");
+                }
+            }
+            // Both engines must see writes from their current transaction,
+            // and the prepared plan must continue to read correctly after rollback.
+            let sql = "SELECT t.id, k.label FROM t LEFT JOIN k ON t.g = k.g \
+                       ORDER BY t.v DESC, t.id DESC LIMIT ?1 OFFSET ?2";
+            let prepared = f.prepare(sql).await.unwrap();
+            for command in [
+                "BEGIN; UPDATE t SET v = 'zzz', g = 100 WHERE id = 2; DELETE FROM k WHERE g = 4;",
+                "ROLLBACK;",
+            ] {
+                f.execute_batch(command).await.unwrap();
+                r.execute_batch(command).unwrap();
+                let rows = prepared
+                    .query_with_params(&[SqliteValue::Integer(8), SqliteValue::Integer(0)])
+                    .await
+                    .unwrap();
+                assert_eq!(tag_rows(&rows), rq(&r, sql, &[8, 0]).unwrap(), "{command}");
+            }
+            f.close().await.unwrap();
+        }
+    });
+}
