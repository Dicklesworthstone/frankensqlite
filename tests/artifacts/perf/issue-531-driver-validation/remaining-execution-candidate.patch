+#[test]
+fn ordered_lookup_join_retains_sorter_when_order_is_not_proven() {
+    use fsqlite_ast::SortDirection;
+    use fsqlite_types::opcode::Opcode;
+
+    let mut schema = snapshot_schema();
+    let mut ordered = index("docs_score_id", 14, &["score", "id"], false);
+    ordered.key_sort_directions = vec![SortDirection::Desc, SortDirection::Desc];
+    schema[0].indexes.push(ordered);
+    for suffix in [
+        "ORDER BY d.score DESC",
+        "ORDER BY c.name,d.id DESC",
+        "ORDER BY d.score DESC NULLS FIRST,d.id DESC",
+        "ORDER BY d.score DESC,d.id ASC",
+    ] {
+        let stmt = parse_select(&format!(
+            "SELECT d.id,c.name FROM docs d JOIN categories c ON c.id=d.category_id \
+             {suffix} LIMIT ?1"
+        ))
+        .unwrap();
+        assert!(!fsqlite_vdbe::codegen::join_select_streams_order_by(
+            &stmt, &schema
+        ));
+        let mut builder = ProgramBuilder::new();
+        codegen_select(
+            &mut builder,
+            &stmt,
+            &schema,
+            &CodegenContext {
+                index_ordered_scan_reliable: true,
+                ..CodegenContext::default()
+            },
+        )
+        .unwrap();
+        let program = builder.finish().unwrap();
+        assert!(
+            program
+                .ops()
+                .iter()
+                .any(|op| op.opcode == Opcode::SorterOpen),
+            "{suffix}"
+        );
+    }
+
+    // Explicit COLLATE already uses the connection's fallback because the
+    // lookup-join compiler does not emit this expression. It must not be
+    // admitted to the ordered index path merely because the columns match.
+    let stmt = parse_select(
+        "SELECT d.id,c.name FROM docs d JOIN categories c ON c.id=d.category_id \
+         ORDER BY d.score COLLATE NOCASE DESC,d.id DESC LIMIT ?1",
+    )
+    .unwrap();
+    assert!(!fsqlite_vdbe::codegen::join_select_streams_order_by(
+        &stmt, &schema
+    ));
+    let mut builder = ProgramBuilder::new();
+    assert!(matches!(
+        codegen_select(
+            &mut builder,
+            &stmt,
+            &schema,
+            &CodegenContext {
+                index_ordered_scan_reliable: true,
+                ..CodegenContext::default()
+            },
+        ),
+        Err(fsqlite_vdbe::codegen::CodegenError::Unsupported(_))
+    ));
+}
