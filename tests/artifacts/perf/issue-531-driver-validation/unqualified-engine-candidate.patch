+fn emit_join_ordered_outer_loop_start(
+    b: &mut ProgramBuilder,
+    order: &JoinOuterOrder,
+    left_cursor: i32,
+    done: Label,
+) -> OuterLoop {
+    match order {
+        JoinOuterOrder::Rowid(direction) => {
+            let descending = *direction == SortDirection::Desc;
+            b.emit_jump_to_label(
+                if descending { Opcode::Last } else { Opcode::Rewind },
+                left_cursor,
+                0,
+                done,
+                P4::None,
+                0,
+            );
+            if descending { OuterLoop::ReverseScan } else { OuterLoop::Scan }
+        }
+        JoinOuterOrder::Index(plan) => {
+            let idx_cursor = b.alloc_aux_cursor_range(1);
+            let idx_row = b.emit_label();
+            let idx_advance = b.emit_label();
+            b.emit_op(
+                Opcode::OpenRead,
+                idx_cursor,
+                plan.index.root_page,
+                0,
+                P4::Index(plan.index.name.clone()),
+                0,
+            );
+            b.emit_jump_to_label(
+                if plan.descending { Opcode::Last } else { Opcode::Rewind },
+                idx_cursor,
+                0,
+                done,
+                P4::None,
+                0,
+            );
+            b.resolve_label(idx_row);
