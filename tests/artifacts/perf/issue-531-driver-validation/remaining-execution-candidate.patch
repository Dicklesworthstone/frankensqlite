+#[test]
+fn ordered_lookup_join_preserves_selective_swapped_outer_seek() {
+    use fsqlite_ast::SortDirection;
+    use fsqlite_types::opcode::{Opcode, P4};
+
+    let mut schema = snapshot_schema();
+    let mut ordered = index("docs_score_id", 14, &["score", "id"], false);
+    ordered.key_sort_directions = vec![SortDirection::Desc, SortDirection::Desc];
+    schema[0].indexes.push(ordered);
+    schema[1].columns.push(column("k", 'A', false));
+    schema[1]
+        .indexes
+        .push(index("categories_k", 15, &["k"], false));
+    let stmt = parse_select(
+        "SELECT d.id,c.name FROM docs d JOIN categories c ON c.k=d.category_id \
+         WHERE c.id=?1 ORDER BY d.score DESC,d.id DESC LIMIT ?2",
+    )
+    .unwrap();
+    // The typeless-to-numeric swapped lookup can seek one category directly;
+    // an available ordering index must not replace that with a full docs scan.
+    assert!(!fsqlite_vdbe::codegen::join_select_streams_order_by(
+        &stmt, &schema
+    ));
+    assert!(fsqlite_vdbe::codegen::join_select_seeks_outer_table(
+        &stmt, &schema
+    ));
+    let mut builder = ProgramBuilder::new();
+    codegen_select(
+        &mut builder,
+        &stmt,
+        &schema,
+        &CodegenContext {
+            index_ordered_scan_reliable: true,
+            ..CodegenContext::default()
+        },
+    )
+    .unwrap();
+    let program = builder.finish().unwrap();
+    let ops = program.ops();
+    assert!(ops.iter().any(|op| op.opcode == Opcode::OpenRead
+        && op.p1 == 0
+        && matches!(&op.p4, P4::Table(name) if name == "categories")));
+    assert!(
+        ops.iter()
+            .any(|op| op.opcode == Opcode::SeekRowid && op.p1 == 0)
+    );
+    assert!(!ops.iter().any(|op| op.opcode == Opcode::OpenRead
+        && matches!(&op.p4, P4::Index(name) if name == "docs_score_id")));
+    assert!(!ops.iter().any(|op| op.opcode == Opcode::OpenAutoindex));
+    assert!(ops.iter().any(|op| op.opcode == Opcode::SorterOpen));
+}
