diff --git a/crates/fsqlite-core/src/connection/busy_timeout.rs b/crates/fsqlite-core/src/connection/busy_timeout.rs
new file mode 100644
--- /dev/null
+++ b/crates/fsqlite-core/src/connection/busy_timeout.rs
@@ -0,0 +1,358 @@
+//! One busy timeout per statement, shared by admission and whole-statement retry.
+//!
+//! GH#423: starting a fresh clock in each retry layer doubles a contended
+//! `BEGIN IMMEDIATE`'s wait. The statement future owns its context; the
+//! connection exposes it only during a poll. Nested execution on that
+//! connection inherits the context; independent suspended futures keep separate
+//! clocks. The clock starts on first contention, not on an uncontended dispatch.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+use std::time::Duration;
+
+use fsqlite_types::sync_primitives::Instant;
+
+type Timing = (Instant, Duration);
+
+#[derive(Clone, Default)]
+pub(super) struct BusyTimeoutContext(Rc<Cell<Option<Timing>>>);
+
+#[derive(Default)]
+pub(super) struct BusyTimeoutState {
+    active: RefCell<Option<BusyTimeoutContext>>,
+}
+
+impl BusyTimeoutState {
+    /// Install a future's context for one poll. Choose its parent on the first
+    /// poll, not at construction: constructing a future is not executing it.
+    pub(super) fn enter(
+        &self,
+        saved: &mut Option<BusyTimeoutContext>,
+    ) -> BusyTimeoutGuard<'_> {
+        let context = saved.get_or_insert_with(|| self.active.borrow().clone().unwrap_or_default());
+        let previous = self.active.replace(Some(context.clone()));
+        BusyTimeoutGuard {
+            state: self,
+            previous,
+        }
+    }
+
+    /// Return the original start and allowance, never a replenished budget.
+    /// Outside statement dispatch (for example, connection bootstrap), the
+    /// caller retains its existing independent retry-loop budget.
+    #[must_use]
+    pub(super) fn timing(&self, timeout: Duration) -> (Instant, Duration) {
+        self.timing_at(timeout, Instant::now())
+    }
+
+    fn timing_at(&self, timeout: Duration, now: Instant) -> Timing {
+        let active = self.active.borrow();
+        let Some(context) = active.as_ref() else {
+            return (now, timeout);
+        };
+        if let Some(timing) = context.0.get() {
+            return timing;
+        }
+        let timing = (now, timeout);
+        context.0.set(Some(timing));
+        timing
+    }
+}
+
+#[must_use = "keep the busy-timeout guard alive for exactly one poll"]
+pub(super) struct BusyTimeoutGuard<'a> {
+    state: &'a BusyTimeoutState,
+    previous: Option<BusyTimeoutContext>,
+}
+
+impl Drop for BusyTimeoutGuard<'_> {
+    fn drop(&mut self) {
+        self.state.active.replace(self.previous.take());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn remaining_at(timing: Timing, now: Instant) -> Duration {
+        timing.1.saturating_sub(now.duration_since(timing.0))
+    }
+
+    #[test]
+    fn issue423_admission_exhaustion_does_not_refill_outer_retry() {
+        for timeout in [Duration::from_millis(250), Duration::from_secs(1)] {
+            let state = BusyTimeoutState::default();
+            let mut saved = None;
+            let _scope = state.enter(&mut saved);
+            let start = Instant::now();
+            let admission = state.timing_at(timeout, start);
+            let outer = state.timing_at(timeout, start + timeout);
+            assert_eq!(outer, admission);
+            assert_eq!(remaining_at(outer, start + timeout), Duration::ZERO);
+        }
+    }
+
+    #[test]
+    fn issue423_publication_and_nested_admission_share_only_the_remainder() {
+        let state = BusyTimeoutState::default();
+        let mut outer_saved = None;
+        let mut inner_saved = None;
+        let _outer_scope = state.enter(&mut outer_saved);
+        let timeout = Duration::from_millis(100);
+        let start = Instant::now();
+        let publication = state.timing_at(timeout, start);
+        {
+            let _inner_scope = state.enter(&mut inner_saved);
+            // Publication already consumed 70% before admission is reached.
+            let now = start + Duration::from_millis(70);
+            let admission = state.timing_at(timeout, now);
+            assert_eq!(admission, publication);
+            assert_eq!(remaining_at(admission, now), Duration::from_millis(30));
+        }
+        assert_eq!(state.timing_at(timeout, start + timeout), publication);
+    }
+
+    #[test]
+    fn issue423_first_contention_in_nested_execution_starts_parent_clock() {
+        let state = BusyTimeoutState::default();
+        let mut outer_saved = None;
+        let mut inner_saved = None;
+        let _outer_scope = state.enter(&mut outer_saved);
+        let start = Instant::now();
+        let timeout = Duration::from_millis(250);
+        let admission = {
+            let _inner_scope = state.enter(&mut inner_saved);
+            state.timing_at(timeout, start)
+        };
+        assert_eq!(state.timing_at(timeout, start + timeout), admission);
+    }
+
+    #[test]
+    fn issue423_clock_is_lazy_and_zero_allowance_cannot_be_rearmed() {
+        let state = BusyTimeoutState::default();
+        let mut saved = None;
+        let _scope = state.enter(&mut saved);
+        assert!(saved.as_ref().unwrap().0.get().is_none());
+        let start = Instant::now();
+        let first = state.timing_at(Duration::ZERO, start);
+        let later = state.timing_at(Duration::from_secs(1), start + Duration::from_secs(1));
+        assert_eq!(later, first);
+        assert_eq!(remaining_at(later, start), Duration::ZERO);
+    }
+
+    #[test]
+    fn issue423_standalone_admission_has_an_independent_budget() {
+        let state = BusyTimeoutState::default();
+        let start = Instant::now();
+        let timeout = Duration::from_secs(1);
+        assert_eq!(state.timing_at(timeout, start), (start, timeout));
+        let later = start + timeout;
+        assert_eq!(state.timing_at(timeout, later), (later, timeout));
+        assert!(state.active.borrow().is_none());
+    }
+
+    #[test]
+    fn issue423_panic_restores_the_previously_active_context() {
+        let state = BusyTimeoutState::default();
+        let mut outer_saved = None;
+        let _outer_scope = state.enter(&mut outer_saved);
+        let start = Instant::now();
+        let timeout = Duration::from_secs(1);
+        let original = state.timing_at(timeout, start);
+        let panic = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let mut nested_saved = None;
+            let _nested_scope = state.enter(&mut nested_saved);
+            panic!("injected unwind while a nested statement is polled");
+        }));
+        assert!(panic.is_err());
+        assert_eq!(state.timing_at(timeout, start + timeout), original);
+    }
+
+    #[test]
+    fn issue423_statement_wrapper_keeps_suspended_futures_independent() {
+        use crate::connection::Connection;
+        use std::future::{Future, poll_fn};
+        use std::task::{Context, Poll, Waker};
+
+        asupersync::test_utils::run_test(|| async {
+            let conn = Connection::open(":memory:").await.unwrap();
+            let timeout = Duration::from_millis(250);
+            let start = Instant::now();
+            let now = Cell::new(start);
+            let observed_a = Cell::new(None);
+            let observed_b = Cell::new(None);
+            let finish_b = Cell::new(false);
+            let mut a = Box::pin(conn.with_fallback_statement(Box::pin(poll_fn(|_| {
+                let timing = conn.statement_busy_timeout.timing_at(timeout, now.get());
+                if let Some(previous) = observed_a.replace(Some(timing)) {
+                    assert_eq!(timing, previous);
+                }
+                Poll::<()>::Pending
+            }))));
+            let mut b = Box::pin(conn.with_fallback_statement(Box::pin(poll_fn(|_| {
+                let timing = conn.statement_busy_timeout.timing_at(timeout, now.get());
+                if let Some(previous) = observed_b.replace(Some(timing)) {
+                    assert_eq!(timing, previous);
+                }
+                if finish_b.get() {
+                    Poll::Ready(())
+                } else {
+                    Poll::Pending
+                }
+            }))));
+            let mut cx = Context::from_waker(Waker::noop());
+            assert!(a.as_mut().poll(&mut cx).is_pending());
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            now.set(start + timeout);
+            assert!(b.as_mut().poll(&mut cx).is_pending());
+            assert_ne!(observed_a.get(), observed_b.get());
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            now.set(start + timeout + timeout);
+            assert!(a.as_mut().poll(&mut cx).is_pending());
+            // Cancellation while another statement is suspended must not
+            // restore the cancelled statement's context onto the connection.
+            drop(a);
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            finish_b.set(true);
+            assert!(b.as_mut().poll(&mut cx).is_ready());
+            drop(b);
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            conn.with_fallback_statement(Box::pin(async {
+                assert_eq!(
+                    conn.statement_busy_timeout.timing_at(timeout, now.get()),
+                    (now.get(), timeout)
+                );
+            }))
+            .await;
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            conn.close().await.unwrap();
+        });
+    }
+
+    #[test]
+    fn issue423_statement_wrapper_shares_the_parent_budget() {
+        use crate::connection::Connection;
+
+        asupersync::test_utils::run_test(|| async {
+            let conn = Connection::open(":memory:").await.unwrap();
+            let timeout = Duration::from_secs(1);
+            let start = Instant::now();
+            conn.with_fallback_statement(Box::pin(async {
+                let original = conn.statement_busy_timeout.timing_at(timeout, start);
+                conn.with_fallback_statement(Box::pin(async {
+                    assert_eq!(
+                        conn.statement_busy_timeout.timing_at(timeout, start + timeout),
+                        original
+                    );
+                }))
+                .await;
+                assert_eq!(
+                    conn.statement_busy_timeout.timing_at(timeout, start + timeout),
+                    original
+                );
+            }))
+            .await;
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            conn.close().await.unwrap();
+        });
+    }
+
+    #[test]
+    fn issue423_future_constructed_in_parent_but_polled_later_is_independent() {
+        use crate::connection::Connection;
+
+        asupersync::test_utils::run_test(|| async {
+            let conn = Connection::open(":memory:").await.unwrap();
+            let timeout = Duration::from_secs(1);
+            let start = Instant::now();
+            let later = start + timeout;
+            let conn_ref = &conn;
+            let deferred = conn_ref
+                .with_fallback_statement(Box::pin(async move {
+                    conn_ref.statement_busy_timeout.timing_at(timeout, start);
+                    conn_ref.with_fallback_statement(Box::pin(async move {
+                        assert_eq!(
+                            conn_ref.statement_busy_timeout.timing_at(timeout, later),
+                            (later, timeout)
+                        );
+                    }))
+                }))
+                .await;
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            deferred.await;
+            assert!(conn.statement_busy_timeout.active.borrow().is_none());
+            conn.close().await.unwrap();
+        });
+    }
+
+    #[cfg(feature = "native")]
+    #[test]
+    fn issue423_real_admission_after_publication_uses_remaining_time() {
+        use crate::connection::Connection;
+        use fsqlite_error::FrankenError;
+
+        asupersync::test_utils::run_test(|| async {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("issue423_shared_deadline.db");
+            let path = path.to_str().unwrap();
+            let holder = Connection::open(path).await.unwrap();
+            holder.execute("PRAGMA journal_mode=WAL").await.unwrap();
+            holder.execute("PRAGMA wal_autocheckpoint=0").await.unwrap();
+            holder.execute("CREATE TABLE t(v INTEGER)").await.unwrap();
+            let waiter = Connection::open(path).await.unwrap();
+            waiter.execute("PRAGMA wal_autocheckpoint=0").await.unwrap();
+            waiter.execute("PRAGMA busy_timeout=1000").await.unwrap();
+            holder.execute("BEGIN IMMEDIATE").await.unwrap();
+            holder.execute("INSERT INTO t VALUES(1)").await.unwrap();
+
+            let started = Instant::now();
+            // Model an earlier publication-bind phase spending 750 ms without
+            // sleeping or racing a checkpointer. The remaining admission and
+            // outer retry are the real BEGIN IMMEDIATE execution paths.
+            let publication_start = started
+                .checked_sub(Duration::from_millis(750))
+                .expect("monotonic clock supports the simulated prior phase");
+            let result = waiter
+                .with_fallback_statement(Box::pin(async {
+                    waiter
+                        .statement_busy_timeout
+                        .timing_at(Duration::from_secs(1), publication_start);
+                    waiter.execute("BEGIN IMMEDIATE").await
+                }))
+                .await;
+            let elapsed = started.elapsed();
+            let waiter_open = waiter.in_transaction();
+            let holder_open = holder.in_transaction();
+            let context_restored = waiter.statement_busy_timeout.active.borrow().is_none();
+            if waiter_open {
+                waiter.execute("ROLLBACK").await.unwrap();
+            }
+            holder.execute("ROLLBACK").await.unwrap();
+            waiter.execute("BEGIN IMMEDIATE").await.unwrap();
+            waiter.execute("ROLLBACK").await.unwrap();
+            waiter.close().await.unwrap();
+            holder.close().await.unwrap();
+            assert!(
+                matches!(
+                    &result,
+                    Err(
+                        FrankenError::Busy
+                            | FrankenError::BusyRecovery
+                            | FrankenError::BusySnapshot { .. }
+                    )
+                ),
+                "held writer must refuse BEGIN with a busy-family error: {result:?}"
+            );
+            assert!(!waiter_open, "a refused BEGIN must not leave a transaction");
+            assert!(holder_open, "the waiter must not end the holder's transaction");
+            assert!(context_restored, "the completed poll must restore its context");
+            assert!(
+                elapsed >= Duration::from_millis(200)
+                    && elapsed <= Duration::from_millis(600),
+                "GH#423: admission after 750 ms of a 1000 ms budget took {elapsed:?}; \
+                 expected approximately the remaining 250 ms, not another full budget"
+            );
+        });
+    }
+}
