+#[test]
+fn ordered_join_plan_uses_outer_index_or_bounded_sorter() {
+    let _serial = serial();
+    asupersync::test_utils::run_test(|| async {
+        let dir = tempfile::tempdir().unwrap();
+        let (f, _) = open_pair(true, &dir).await;
+        f.execute_batch(ORDERED_SETUP).await.unwrap();
+        let ordered = f
+            .query(
+                "EXPLAIN SELECT t.id, k.label FROM t JOIN k ON k.g = t.g \
+             ORDER BY t.n DESC, t.id DESC LIMIT 5 OFFSET 2",
+            )
+            .await
+            .unwrap();
+        let has_opcode = |rows: &[fsqlite_core::connection::Row], name: &str| {
+            rows.iter().any(|row| {
+                row.values().get(1).is_some_and(
+                    |value| matches!(value, SqliteValue::Text(opcode) if opcode.as_str() == name),
+                )
+            })
+        };
+        assert!(!has_opcode(&ordered, "SorterOpen"), "{ordered:?}");
+        assert!(has_opcode(&ordered, "IdxRowid"), "{ordered:?}");
+        assert!(has_opcode(&ordered, "DecrJumpZero"), "{ordered:?}");
+        let sorted = f
+            .query(
+                "EXPLAIN SELECT t.id, k.label FROM t JOIN k ON k.g = t.g \
+             ORDER BY k.label DESC, t.id DESC LIMIT ?1 OFFSET ?2",
+            )
+            .await
+            .unwrap();
+        let sorter = sorted
+            .iter()
+            .find(|row| {
+                matches!(row.values().get(1), Some(SqliteValue::Text(opcode))
+                    if opcode.as_str() == "SorterOpen")
+            })
+            .expect("inner-side ordering needs a sorter");
+        assert!(
+            matches!(sorter.values().get(4), Some(SqliteValue::Integer(reg)) if *reg > 0),
+            "top-N retention must read a runtime bound register: {sorter:?}"
+        );
+        assert!(
+            matches!(sorter.values().get(6), Some(SqliteValue::Integer(flags))
+            if *flags & i64::from(fsqlite_types::opcode::SORTER_OPEN_TOP_N_REGISTER) != 0),
+            "top-N register mode must be enabled: {sorter:?}"
+        );
+        assert!(has_opcode(&sorted, "OffsetLimit"), "{sorted:?}");
+        let sorted_count = f
+            .query(
+                "EXPLAIN SELECT t.id, k.label, \
+                 (SELECT COUNT(*) FROM u WHERE u.tid = t.id) AS matched_count \
+                 FROM t JOIN k ON k.g = t.g \
+                 ORDER BY matched_count DESC, t.id DESC LIMIT 5",
+            )
+            .await
+            .unwrap();
+        assert!(has_opcode(&sorted_count, "SorterOpen"), "{sorted_count:?}");
+        assert!(has_opcode(&sorted_count, "AddImm"), "{sorted_count:?}");
+        let zero_sql = "SELECT t.id, k.label FROM t JOIN k ON k.g = t.g \
+                        ORDER BY k.label, t.id LIMIT 0 OFFSET 'not an integer'";
+        assert!(f.query(zero_sql).await.unwrap().is_empty());
+        let zero = f.query(&format!("EXPLAIN {zero_sql}")).await.unwrap();
+        let opcode_field = |name: &str, field: usize| {
+            let row = zero
+                .iter()
+                .find(|row| {
+                    matches!(row.values().get(1), Some(SqliteValue::Text(opcode))
+                    if opcode.as_str() == name)
+                })
+                .unwrap_or_else(|| panic!("missing {name} in {zero:?}"));
+            let Some(SqliteValue::Integer(value)) = row.values().get(field) else {
+                panic!("noninteger field {field} in {row:?}");
+            };
+            *value
+        };
+        assert!(
+            opcode_field("IfNot", 3) > opcode_field("SorterSort", 0),
+            "LIMIT 0 must skip output from its unopened sorter: {zero:?}"
+        );
+        f.close().await.unwrap();
+    });
+}
