+    let table_access = root_access(program, table.root_page);
+    let mut indexes = table.indexes.iter().filter_map(|index| {
+        let facts = root_access(program, index.root_page);
+        facts.positioned.then_some((index, facts))
+    });
+    if let Some((index, facts)) = indexes.next() {
+        // Multiple indexes, or a table-scan alternative to an index seek,
+        // need a richer plan tree. Do not call an ambiguous access SEARCH.
+        if indexes.next().is_some() || table_access.full_scan {
+            return None;
+        }
+        let action = if facts.key_seek && !facts.full_scan {
+            "SEARCH"
