diff --git a/crates/fsqlite-core/src/connection/table_function_exists.rs b/crates/fsqlite-core/src/connection/table_function_exists.rs
new file mode 100644
index 0000000..2e7e685
--- /dev/null
+++ b/crates/fsqlite-core/src/connection/table_function_exists.rs
@@ -0,0 +1,1181 @@
+//! GH#533: plan and stream a bound table-function EXISTS probe.
+//!
+//! The general join path materializes a table function before its WHERE and
+//! LIMIT. A correlated EXISTS must instead be able to pass constraints to the
+//! cursor and stop on its first qualifying row. The initial admission is the
+//! unchanged built-in `generate_series` factory: its hidden positional columns
+//! and `xBestIndex` protocol are known. Overrides retain the general path.
+
+#[allow(clippy::wildcard_imports)]
+use super::*;
+
+struct TableFunctionExistsFilter {
+    idx_num: i32,
+    idx_str: Option<String>,
+    args: Vec<SqliteValue>,
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct ExistsCursorWork {
+    filters: usize,
+    rows: usize,
+    nexts: usize,
+}
+
+#[cfg(test)]
+thread_local! {
+    static EXISTS_CURSOR_WORK: Cell<ExistsCursorWork> = const {
+        Cell::new(ExistsCursorWork { filters: 0, rows: 0, nexts: 0 })
+    };
+}
+
+impl Connection {
+    /// `subquery` has already had its outer references bound, retaining their
+    /// comparison metadata, and its irrelevant EXISTS projection stripped.
+    #[allow(clippy::too_many_lines)]
+    pub(super) fn try_table_function_exists_probe(
+        &self,
+        subquery: &SelectStatement,
+    ) -> Option<Result<bool>> {
+        if subquery.with.is_some()
+            || !subquery.body.compounds.is_empty()
+            || subquery.limit.is_some()
+            || !subquery.order_by.is_empty()
+            || select_contains_any_placeholder(subquery)
+        {
+            return None;
+        }
+        let SelectCore::Select {
+            columns,
+            from: Some(from),
+            where_clause,
+            group_by,
+            having,
+            windows,
+            distinct: Distinctness::All,
+            ..
+        } = &subquery.body.select
+        else {
+            return None;
+        };
+        if !from.joins.is_empty()
+            || !group_by.is_empty()
+            || having.is_some()
+            || !windows.is_empty()
+            || !columns.iter().all(|column| {
+                matches!(
+                    column,
+                    ResultColumn::Star
+                        | ResultColumn::Expr {
+                            expr: Expr::Literal(..),
+                            ..
+                        }
+                )
+            })
+        {
+            return None;
+        }
+        let TableOrSubquery::TableFunction { name, args, .. } = &from.source else {
+            return None;
+        };
+        if !name.eq_ignore_ascii_case("generate_series") || !(1..=3).contains(&args.len()) {
+            return None;
+        }
+        let key = name.to_ascii_uppercase();
+        let factory = self.vtab_modules.borrow().get(&key)?.clone();
+        if !Arc::ptr_eq(&factory, shared_default_vtab_module_registry().get(&key)?) {
+            return None;
+        }
+        let registry = lock_unpoisoned(self.collation_registry.as_ref()).clone();
+        if !["BINARY", "NOCASE", "RTRIM"]
+            .iter()
+            .all(|name| registry.uses_builtin_implementation(name))
+        {
+            return None;
+        }
+
+        // No expression with observable evaluation effects changes frequency
+        // when the scan stops early. Unknown names, functions, nested scopes
+        // and bind parameters retain their ordinary evaluator and diagnostics.
+        let col_map = self.build_join_col_map(subquery);
+        let predicate = where_clause.as_deref();
+        if predicate.is_some_and(|expr| {
+            !exists_cursor_expr_is_pure(expr) || !expr_references_only_col_map(expr, &col_map)
+        }) || !args
+            .iter()
+            .all(|expr| exists_cursor_expr_is_pure(expr) && expr_references_only_col_map(expr, &[]))
+        {
+            return None;
+        }
+        let arg_values = match args
+            .iter()
+            .map(|expr| eval_join_expr(expr, &[], &[]))
+            .collect::<Result<Vec<_>>>()
+        {
+            Ok(values) => values,
+            Err(error) => return Some(Err(error)),
+        };
+
+        // Use the same metadata and residual evaluator as the general join
+        // path. BoundOuterValue must keep its affinity/collation throughout.
+        let context = JoinEvalCollationContext {
+            declared_json_keys: self.build_join_declared_blob_columns(subquery),
+            column_collations: self.build_join_col_collations(subquery),
+            column_affinities: self.build_join_col_affinities(subquery),
+            using_column_projections: HashMap::new(),
+            registry,
+        };
+        let _context_guard = JoinEvalCollationContextGuard::push(context.clone());
+        let mut bindings = JoinExprBindings::default();
+        let mut needed_columns = vec![false; col_map.len()];
+        if let Some(predicate) = predicate {
+            bindings.bind_expr(predicate, &col_map, None);
+            bindings.bind_comparison_collations(predicate);
+            for_each_column_ref_in_expr(predicate, &mut |column| {
+                if let Ok(index) =
+                    find_col_in_map(&col_map, column.table.as_deref(), &column.column, None)
+                {
+                    needed_columns[index] = true;
+                }
+            });
+        }
+        let _bindings_guard = JoinExprBindingsGuard::push(bindings);
+        // These are column numbers, not tightened start/stop values. The
+        // module keeps the original hidden arguments and series alignment.
+        let argument_columns = &[1, 2, 3][..arg_values.len()];
+        Some(self.run_table_function_exists_probe(
+            name,
+            &factory,
+            &arg_values,
+            argument_columns,
+            predicate,
+            &col_map,
+            &context,
+            &needed_columns,
+        ))
+    }
+
+    fn run_table_function_exists_probe(
+        &self,
+        name: &str,
+        factory: &Arc<dyn VtabModuleFactory>,
+        arg_values: &[SqliteValue],
+        argument_columns: &[i32],
+        predicate: Option<&Expr>,
+        col_map: &[(String, String, bool)],
+        context: &JoinEvalCollationContext,
+        needed_columns: &[bool],
+    ) -> Result<bool> {
+        let cx = self.op_cx()?;
+        let factory_args = [name, "main", name];
+        let instance =
+            self.invoke_live_vtab_callback("xConnect", || factory.connect(&cx, &factory_args))?;
+        let pending = PendingLiveVtabGuard::connected(self, &cx, name, instance);
+        let scan_result = (|| {
+            let filter = self.plan_table_function_exists_filter(
+                pending.instance(),
+                name,
+                arg_values,
+                argument_columns,
+                predicate,
+                col_map,
+                context,
+            )?;
+            self.scan_table_function_exists_cursor(
+                pending.instance(),
+                &filter,
+                predicate,
+                col_map,
+                needed_columns,
+            )
+        })();
+        // The cursor is dropped before disconnect, including on an early
+        // match or an error; both guards retain the callback reentrancy rules.
+        let cleanup_result = pending.cleanup();
+        match (scan_result, cleanup_result) {
+            (Ok(found), Ok(())) => Ok(found),
+            (Err(scan_error), Ok(())) => Err(scan_error),
+            (Ok(_), Err(cleanup_error)) => Err(cleanup_error),
+            (Err(scan_error), Err(cleanup_error)) => Err(FrankenError::Internal(format!(
+                "table-valued function {name} EXISTS scan failed: {scan_error}; disconnect failed: {cleanup_error}"
+            ))),
+        }
+    }
+
+    #[allow(clippy::too_many_lines)]
+    fn plan_table_function_exists_filter(
+        &self,
+        instance: &dyn ErasedVtabInstance,
+        name: &str,
+        arg_values: &[SqliteValue],
+        argument_columns: &[i32],
+        predicate: Option<&Expr>,
+        col_map: &[(String, String, bool)],
+        context: &JoinEvalCollationContext,
+    ) -> Result<TableFunctionExistsFilter> {
+        let mut constraints: Vec<_> = argument_columns
+            .iter()
+            .map(|&column| IndexConstraint {
+                column,
+                op: ConstraintOp::Eq,
+                usable: true,
+            })
+            .collect();
+        let mut values = arg_values.to_vec();
+        if let Some(predicate) = predicate {
+            let mut terms = Vec::new();
+            flatten_and_terms(predicate, &mut terms);
+            for term in terms {
+                let Some(mut candidate) =
+                    extract_live_vtab_constraint_candidate(term, col_map, name)
+                else {
+                    continue;
+                };
+                // Positional arguments alone define hidden input columns.
+                // Additional WHERE tests of them stay residual, including
+                // checks of coerced/defaulted/normalized argument values.
+                if !matches!(candidate.constraint.column, -1 | 0) {
+                    continue;
+                }
+                let Expr::BinaryOp { left, right, .. } = term else {
+                    continue;
+                };
+                // A bound outer TEXT column can hold a numeric runtime value
+                // (for example in a compound SELECT). Numeric range pruning
+                // is not a valid substitute for text comparison ordering.
+                if join_expr_affinity(left, col_map, context) == TypeAffinity::Text
+                    || join_expr_affinity(right, col_map, context) == TypeAffinity::Text
+                {
+                    continue;
+                }
+                let constant = if matches!(left.as_ref(), Expr::Column(..)) {
+                    right.as_ref()
+                } else {
+                    left.as_ref()
+                };
+                // In particular, use SQL's real result for negating MIN_I64;
+                // the general candidate extractor only recognizes the shape.
+                candidate.value = eval_join_expr(constant, &[], &[])?;
+                constraints.push(candidate.constraint);
+                values.push(candidate.value);
+            }
+        }
+        let mut info = IndexInfo::new(constraints, Vec::new());
+        let input_constraints = info.constraints.clone();
+        self.invoke_live_vtab_callback("xBestIndex", || instance.best_index(&mut info))?;
+        let malfunction = || FrankenError::FunctionError(format!("{name}.xBestIndex malfunction"));
+        if info.constraints != input_constraints
+            || !info.order_by.is_empty()
+            || info.constraint_usage.len() != values.len()
+        {
+            return Err(malfunction());
+        }
+        let mut ordered_args: Vec<_> = info
+            .constraint_usage
+            .iter()
+            .zip(values)
+            .filter_map(|(usage, value)| {
+                (usage.argv_index > 0).then_some((usage.argv_index, value))
+            })
+            .collect();
+        ordered_args.sort_by_key(|(index, _)| *index);
+        for (position, (actual, _)) in ordered_args.iter().enumerate() {
+            let expected = i32::try_from(position)
+                .ok()
+                .and_then(|index| index.checked_add(1))
+                .ok_or_else(malfunction)?;
+            if *actual != expected {
+                return Err(malfunction());
+            }
+        }
+        if info.constraint_usage[..arg_values.len()]
+            .iter()
+            .any(|usage| usage.argv_index <= 0)
+        {
+            // A module that did not consume every positional input must keep
+            // the original positional xFilter protocol. Never drop an input
+            // or mistake a visible WHERE bound for START/STOP/STEP.
+            return Ok(TableFunctionExistsFilter {
+                idx_num: 0,
+                idx_str: None,
+                args: arg_values.to_vec(),
+            });
+        }
+        // Keep the complete original predicate, regardless of omit flags.
+        // The cursor only narrows work; SQL owns affinity/collation comparison.
+        Ok(TableFunctionExistsFilter {
+            idx_num: info.idx_num,
+            idx_str: info.idx_str,
+            args: ordered_args.into_iter().map(|(_, value)| value).collect(),
+        })
+    }
+
+    fn scan_table_function_exists_cursor(
+        &self,
+        instance: &dyn ErasedVtabInstance,
+        filter: &TableFunctionExistsFilter,
+        predicate: Option<&Expr>,
+        col_map: &[(String, String, bool)],
+        needed_columns: &[bool],
+    ) -> Result<bool> {
+        let cx = self.op_cx()?;
+        let mut cursor = self.invoke_live_vtab_callback("xOpen", || {
+            instance
+                .open_cursor()
+                .map(|cursor| LiveVtabCursorGuard::new(&self.live_vtab_callback_depth, cursor))
+        })?;
+        self.invoke_live_vtab_callback("xFilter", || {
+            cursor.erased_filter(&cx, filter.idx_num, filter.idx_str.as_deref(), &filter.args)
+        })?;
+        #[cfg(test)]
+        EXISTS_CURSOR_WORK.with(|work| {
+            let mut value = work.get();
+            value.filters += 1;
+            work.set(value);
+        });
+        let mut row = vec![SqliteValue::Null; col_map.len()];
+        while !self.invoke_live_vtab_callback("xEof", || Ok(cursor.erased_eof()))? {
+            #[cfg(test)]
+            EXISTS_CURSOR_WORK.with(|work| {
+                let mut value = work.get();
+                value.rows += 1;
+                work.set(value);
+            });
+            for (index, (_, _, hidden_rowid)) in col_map.iter().enumerate() {
+                if !needed_columns[index] {
+                    continue;
+                }
+                row[index] = if *hidden_rowid {
+                    SqliteValue::Integer(
+                        self.invoke_live_vtab_callback("xRowid", || cursor.erased_rowid())?,
+                    )
+                } else {
+                    let column = i32::try_from(index).map_err(|_| FrankenError::TooBig)?;
+                    let mut ctx = ColumnContext::new();
+                    self.invoke_live_vtab_callback("xColumn", || {
+                        cursor.erased_column(&mut ctx, column)
+                    })?;
+                    ctx.take_value().unwrap_or(SqliteValue::Null)
+                };
+            }
+            let found = match predicate {
+                Some(predicate) => eval_join_predicate(predicate, &row, col_map)?,
+                None => true,
+            };
+            if found {
+                return Ok(true);
+            }
+            self.invoke_live_vtab_callback("xNext", || cursor.erased_next(&cx))?;
+            #[cfg(test)]
+            EXISTS_CURSOR_WORK.with(|work| {
+                let mut value = work.get();
+                value.nexts += 1;
+                work.set(value);
+            });
+        }
+        Ok(false)
+    }
+}
+
+/// Admission for expressions whose evaluation cannot call application code or
+/// change state. It also keeps every nested SELECT and parameter on its current
+/// route. Pure SQL arithmetic/casts and boolean short-circuiting use the normal
+/// join evaluator; no expressions are replaced by a result-specific shortcut.
+fn exists_cursor_expr_is_pure(expr: &Expr) -> bool {
+    match expr {
+        Expr::Literal(
+            Literal::CurrentTime | Literal::CurrentDate | Literal::CurrentTimestamp,
+            _,
+        ) => false,
+        Expr::Literal(..) | Expr::Column(..) => true,
+        Expr::BoundOuterValue { collation, .. } => collation
+            .as_name()
+            .is_none_or(exists_cursor_collation_is_builtin),
+        Expr::BinaryOp { left, right, .. } => {
+            exists_cursor_expr_is_pure(left) && exists_cursor_expr_is_pure(right)
+        }
+        Expr::UnaryOp { expr, .. } | Expr::Cast { expr, .. } | Expr::IsNull { expr, .. } => {
+            exists_cursor_expr_is_pure(expr)
+        }
+        Expr::Collate {
+            expr, collation, ..
+        } => exists_cursor_collation_is_builtin(collation) && exists_cursor_expr_is_pure(expr),
+        Expr::Between {
+            expr, low, high, ..
+        } => {
+            exists_cursor_expr_is_pure(expr)
+                && exists_cursor_expr_is_pure(low)
+                && exists_cursor_expr_is_pure(high)
+        }
+        Expr::In {
+            expr,
+            set: InSet::List(values),
+            ..
+        } => exists_cursor_expr_is_pure(expr) && values.iter().all(exists_cursor_expr_is_pure),
+        Expr::Case {
+            operand,
+            whens,
+            else_expr,
+            ..
+        } => {
+            operand.as_deref().is_none_or(exists_cursor_expr_is_pure)
+                && whens.iter().all(|(when, then)| {
+                    exists_cursor_expr_is_pure(when) && exists_cursor_expr_is_pure(then)
+                })
+                && else_expr.as_deref().is_none_or(exists_cursor_expr_is_pure)
+        }
+        _ => false,
+    }
+}
+
+fn exists_cursor_collation_is_builtin(name: &str) -> bool {
+    ["BINARY", "NOCASE", "RTRIM"]
+        .iter()
+        .any(|builtin| name.eq_ignore_ascii_case(builtin))
+}
