+mod cte_module_callbacks {
+    use super::{Connection, SqliteValue, frank, used_cte_materialization};
+    use fsqlite_error::{FrankenError, Result};
+    use fsqlite_func::vtab::{
+        ColumnContext, ErasedVtabInstance, IndexInfo, VirtualTable, VirtualTableCursor,
+        VtabModuleFactory,
+    };
+    use fsqlite_types::cx::Cx;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Debug, PartialEq)]
+    enum Event {
+        Metadata,
+        Connect,
+        BestIndex,
+        Open,
+        Filter(Vec<SqliteValue>),
+        Eof,
+        Column(i32),
+        Next,
+        Rowid,
+        Disconnect,
+    }
+
+    type Events = Arc<Mutex<Vec<Event>>>;
+
+    struct ProbeFactory {
+        events: Events,
+        fail_column: bool,
+    }
+
+    struct ProbeTable {
+        events: Events,
+        fail_column: bool,
+    }
+
+    struct ProbeCursor {
+        events: Events,
+        fail_column: bool,
+        remaining: i64,
+    }
+
+    impl VtabModuleFactory for ProbeFactory {
+        fn column_info(&self, _args: &[&str]) -> Vec<(String, char)> {
+            self.events.lock().unwrap().push(Event::Metadata);
+            vec![("value".to_owned(), 'A')]
+        }
+
+        fn create(&self, _cx: &Cx, _args: &[&str]) -> Result<Box<dyn ErasedVtabInstance>> {
+            self.events.lock().unwrap().push(Event::Connect);
+            Ok(Box::new(ProbeTable {
+                events: Arc::clone(&self.events),
+                fail_column: self.fail_column,
+            }))
+        }
+    }
+
+    impl VirtualTable for ProbeTable {
+        type Cursor = ProbeCursor;
+
+        fn connect(_cx: &Cx, _args: &[&str]) -> Result<Self> {
+            Err(FrankenError::function_error(
+                "use the stateful probe factory",
+            ))
+        }
+
+        fn best_index(&self, _info: &mut IndexInfo) -> Result<()> {
+            self.events.lock().unwrap().push(Event::BestIndex);
+            Ok(())
+        }
+
+        fn open(&self) -> Result<Self::Cursor> {
+            self.events.lock().unwrap().push(Event::Open);
+            Ok(ProbeCursor {
+                events: Arc::clone(&self.events),
+                fail_column: self.fail_column,
+                remaining: 0,
+            })
+        }
+
+        fn disconnect(&mut self, _cx: &Cx) -> Result<()> {
+            self.events.lock().unwrap().push(Event::Disconnect);
+            Ok(())
+        }
+    }
+
+    impl VirtualTableCursor for ProbeCursor {
+        fn filter(
+            &mut self,
+            _cx: &Cx,
+            _idx_num: i32,
+            _idx_str: Option<&str>,
+            args: &[SqliteValue],
+        ) -> Result<()> {
+            self.events
+                .lock()
+                .unwrap()
+                .push(Event::Filter(args.to_vec()));
+            self.remaining = 2;
+            Ok(())
+        }
+
+        fn next(&mut self, _cx: &Cx) -> Result<()> {
+            self.events.lock().unwrap().push(Event::Next);
+            self.remaining -= 1;
+            Ok(())
+        }
+
+        fn eof(&self) -> bool {
+            self.events.lock().unwrap().push(Event::Eof);
+            self.remaining == 0
+        }
+
+        fn column(&self, ctx: &mut ColumnContext, col: i32) -> Result<()> {
+            self.events.lock().unwrap().push(Event::Column(col));
+            if self.fail_column {
+                return Err(FrankenError::function_error("projected column failure"));
+            }
+            ctx.set_value(SqliteValue::Integer(3 - self.remaining));
+            Ok(())
+        }
+
+        fn rowid(&self) -> Result<i64> {
+            self.events.lock().unwrap().push(Event::Rowid);
+            Ok(3 - self.remaining)
+        }
+    }
+
+    #[test]
+    fn single_use_ctes_preserve_custom_module_callbacks_and_column_errors() {
+        asupersync::test_utils::run_test(|| async {
+            // A built-in spelling must not impersonate the shared built-in
+            // factory. The other name also proves generic extension refusal.
+            for module in ["generate_series", "custom_rows"] {
+                for fail_column in [false, true] {
+                    let mut traces = Vec::new();
+                    for hint in ["", "MATERIALIZED"] {
+                        let conn = Connection::open(":memory:").await.unwrap();
+                        let events = Arc::new(Mutex::new(Vec::new()));
+                        conn.register_module(
+                            module,
+                            Box::new(ProbeFactory {
+                                events: Arc::clone(&events),
+                                fail_column,
+                            }),
+                        );
+                        let sql = format!(
+                            "WITH t AS {hint} (SELECT value FROM {module}(1,4)) SELECT count(*) FROM t"
+                        );
+                        let result = frank(&conn, &sql).await;
+                        if fail_column {
+                            let error = result
+                                .expect_err("count must still observe the projected xColumn error");
+                            assert!(error.contains("projected column failure"), "{sql}: {error}");
+                        } else {
+                            assert_eq!(result.unwrap(), vec![vec!["int:2".to_owned()]], "{sql}");
+                        }
+                        assert!(used_cte_materialization(&conn), "{sql}");
+                        let trace = std::mem::take(&mut *events.lock().unwrap());
+                        assert!(trace.contains(&Event::Metadata), "{sql}");
+                        assert!(
+                            trace.contains(&Event::Filter(vec![1.into(), 4.into()])),
+                            "{sql}"
+                        );
+                        assert_eq!(
+                            trace
+                                .iter()
+                                .filter(|event| **event == Event::Column(0))
+                                .count(),
+                            if fail_column { 1 } else { 2 },
+                            "{sql}",
+                        );
+                        traces.push(trace);
+                        conn.close().await.unwrap();
+                    }
+                    assert_eq!(
+                        traces[0], traces[1],
+                        "callback order/count changed for {module}, fail={fail_column}"
+                    );
+                }
+            }
+        });
+    }
+}
