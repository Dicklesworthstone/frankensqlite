+#[test]
+fn ordered_lookup_join_limits_do_bounded_work() {
+    let _serial = serial();
+    asupersync::test_utils::run_test(|| async {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("ordered.db");
+        // Seed with the live stock oracle so both engines read identical
+        // records/index pages, including descending index key metadata.
+        let oracle = rusqlite::Connection::open(&path).unwrap();
+        oracle.execute_batch(&format!(
+            "CREATE TABLE t(id INTEGER PRIMARY KEY, stamp INTEGER, owner INTEGER);\
+             CREATE TABLE k(id INTEGER PRIMARY KEY, name TEXT);\
+             CREATE INDEX t_stamp_id ON t(stamp DESC, id DESC);\
+             INSERT INTO k VALUES(1,'one'),(2,'two');\
+             WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<{ROWS}) \
+             INSERT INTO t SELECT i, i % 101, i % 3 FROM n;"
+        )).unwrap();
+        let conn = Connection::open(path.to_str().unwrap()).await.unwrap();
+        for order in ["t.stamp DESC, t.id DESC", "t.stamp ASC, t.id ASC", "t.id DESC"] {
+            let sql = format!("SELECT t.id, k.name FROM t JOIN k ON k.id=t.owner \
+                               ORDER BY {order} LIMIT ?1 OFFSET ?2");
+            let prepared = conn.prepare(&sql).await.unwrap();
+            set_hot_path_profile_enabled(true);
+            reset_hot_path_profile();
+            let rows = prepared
+                .query_with_params(&[SqliteValue::Integer(20), SqliteValue::Integer(5)])
+                .await
+                .unwrap();
+            let opcodes = hot_path_profile_snapshot().vdbe.opcodes_executed_total;
+            set_hot_path_profile_enabled(false);
+            assert_eq!(tag_rows(&rows), rq(&oracle, &sql, &[20, 5]).unwrap(), "{sql}");
+            assert!(opcodes > 0 && opcodes <= MAX_LIMITED_OPCODES,
+                "{sql}: {opcodes} opcodes for 20 rows from {ROWS}; the ordering index and \
+                 joined-row LIMIT must prevent a full scan/sort");
+        }
+        conn.close().await.unwrap();
+    });
+}
