+fn benchmark_prepared_issue_531() {
+    let _serial = serial();
+    let posts = std::env::var("FSQLITE_531_POSTS")
+        .map_or(500_000, |value| value.parse().expect("post count"));
+    let trial_ms = std::env::var("FSQLITE_531_TRIAL_MS").map_or(2_000, |value| {
+        value.parse::<u64>().expect("trial milliseconds")
+    });
+    assert!(trial_ms > 0);
+    let trial_window = std::time::Duration::from_millis(trial_ms);
+    asupersync::test_utils::run_test(|| async {
+        let directory = tempfile::tempdir().unwrap();
+        let stock_path = directory.path().join("stock.db");
+        let franken_path = directory.path().join("franken.db");
+        seed(&stock_path, posts);
+        std::fs::copy(&stock_path, &franken_path).unwrap();
+        assert_eq!(
+            std::fs::read(&stock_path).unwrap(),
+            std::fs::read(&franken_path).unwrap()
+        );
+        let r = rusqlite::Connection::open(&stock_path).unwrap();
+        let f = Connection::open(franken_path.to_str().unwrap())
+            .await
+            .unwrap();
+        r.execute_batch("PRAGMA synchronous=NORMAL; PRAGMA foreign_keys=ON;")
+            .unwrap();
+        f.execute_batch("PRAGMA synchronous=NORMAL; PRAGMA foreign_keys=ON;")
+            .await
+            .unwrap();
+        let likes: i64 = r
+            .query_row("SELECT count(*) FROM likes", [], |row| row.get(0))
+            .unwrap();
+        println!(
+            "{}",
+            serde_json::json!({"posts":posts,"users":posts/10,"likes":likes,"sqlite":rusqlite::version(),"fixture":"published CLI recipe","prepared":true})
+        );
+        for case in cases(posts) {
+            let mut stock = r.prepare(&case.sql).unwrap();
+            let prepared = f.prepare(&case.sql).await.unwrap();
+            let params: Vec<_> = case
+                .params
+                .iter()
+                .copied()
+                .map(SqliteValue::Integer)
+                .collect();
+            // One untimed live-oracle warmup per engine. Keep preparation and
+            // output validation outside every timed execution window.
+            let expected = stock_rows(&mut stock, &case.params);
+            let warmup = prepared.query_with_params(&params).await.unwrap();
+            assert_rows(
+                franken_rows(&warmup),
+                expected.clone(),
+                case.ordered,
+                &case.sql,
+            );
+            let mut samples = Vec::new();
+            for trial in 0..5 {
+                for run_franken in [trial % 2 == 0, trial % 2 != 0] {
+                    let mut elapsed = std::time::Duration::ZERO;
+                    let mut iterations = 0_u64;
+                    while iterations == 0 || elapsed < trial_window {
+                        let start = Instant::now();
+                        let actual = if run_franken {
+                            let rows = prepared.query_with_params(&params).await.unwrap();
+                            franken_rows(&rows)
+                        } else {
+                            stock_rows(&mut stock, &case.params)
+                        };
+                        elapsed += start.elapsed();
+                        iterations += 1;
+                        assert_rows(actual, expected.clone(), case.ordered, &case.sql);
+                    }
+                    samples.push(serde_json::json!({
