+        return Err(CodegenError::Unsupported(
+            "unsupported join scalar COUNT(*) shape".to_owned(),
+        ));
+    }
+    let Some(&(table, alias)) = tables.first() else {
+        return Err(CodegenError::Unsupported(
+            "join scalar subquery without an outer table".to_owned(),
+        ));
+    };
+    let secondaries: Vec<_> = (1_i32..)
+        .zip(tables.iter().skip(1))
+        .map(|(cursor, (table, alias))| SecondaryScan {
+            cursor,
+            table,
+            table_alias: *alias,
+            register_base: None,
+        })
+        .collect();
+    let outer_ctx = ScanCtx {
+        cursor: 0,
+        table,
+        table_alias: alias,
+        schema: Some(schema),
+        register_base: None,
+        secondaries: &secondaries,
+    };
+    emit_scalar_subquery(b, subquery, reg, &outer_ctx, schema);
+    Ok(())
+}
