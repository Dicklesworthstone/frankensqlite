+        asupersync::test_utils::run_test(|| async {
+            let f = Connection::open(":memory:").await.unwrap();
+            f.execute_batch(SCHEMA).await.unwrap();
+            let calls = Arc::new(AtomicUsize::new(0));
+            f.register_scalar_function(ProbeCalls(Arc::clone(&calls)));
+            f.set_reject_mem_fallback(true);
+            f.set_strict_mem_fallback_rejection(true);
+            for source in ["posts p", "posts p JOIN users u ON u.id=p.user_id"] {
+                let sql = format!(
