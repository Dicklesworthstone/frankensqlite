+/// An ordered driving-table traversal remains ordered through an INNER or LEFT
+/// lookup join: every inner match is emitted before the next outer row.
+enum JoinOuterOrder {
+    Rowid(SortDirection),
+    Index(OrderByIndexPlan),
+}
+
+/// Resolve an output slot once, including columns expanded from `*`. The
+/// selected expression belongs to FROM scope, not another alias/ordinal scope.
+fn join_output_slot_expr(
+    slot: usize,
+    columns: &[ResultColumn],
+    tables: &[(&TableSchema, Option<&str>)],
+) -> Option<Expr> {
+    let mut start = 0usize;
+    for column in columns {
+        match column {
+            ResultColumn::Expr { expr, .. } => {
+                if start == slot {
+                    return Some(expr.clone());
+                }
+                start += 1;
+            }
+            ResultColumn::Star | ResultColumn::TableStar(_) => {
+                for (table, alias) in tables {
+                    if let ResultColumn::TableStar(name) = column
+                        && !join_qualifier_matches(Some(&name.name), table, *alias)
+                    {
+                        continue;
+                    }
+                    if let Some(relative) = slot.checked_sub(start)
+                        && let Some(info) = table.columns.get(relative)
+                    {
+                        return Some(Expr::Column(
+                            ColumnRef::qualified(alias.unwrap_or(&table.name), info.name.as_str()),
+                            Span::ZERO,
+                        ));
+                    }
+                    start += table.columns.len();
+                }
+            }
+        }
+    }
+    None
+}
+
+/// Reuse index-order planning only when every ordering term names the driving
+/// table. Resolve unqualified names against both tables and aliases against the
+/// output first. Equality seeks take precedence at the caller; non-unique outer
+/// orders retain the sorter to preserve ties at the LIMIT boundary.
+fn resolve_join_outer_order(
+    stmt: &SelectStatement,
+    columns: &[ResultColumn],
+    tables: &[(&TableSchema, Option<&str>)],
+    ctx: &CodegenContext,
+) -> Option<JoinOuterOrder> {
+    let &(table, alias) = tables.first()?;
+    if stmt.order_by.is_empty() || table.without_rowid {
+        return None;
+    }
+    let SelectCore::Select {
+        from: Some(from), ..
+    } = &stmt.body.select
+    else {
+        return None;
+    };
+    let index_hint = std::iter::once(&from.source)
+        .chain(from.joins.iter().map(|join| &join.table))
+        .find_map(|source| match source {
+            TableOrSubquery::Table {
+                name,
+                alias: source_alias,
+                index_hint,
+                ..
+            } if name.name.eq_ignore_ascii_case(&table.name)
+                && source_alias.as_deref() == alias =>
+            {
+                Some(index_hint.as_ref())
+            }
+            _ => None,
+        })
+        .flatten();
+    let out_col_count = resolve_join_output_count(columns, tables);
+    let mut order_by = Vec::with_capacity(stmt.order_by.len());
+    let mut includes_rowid = false;
+    for term in &stmt.order_by {
+        let expr = join_order_output_slot(&term.expr, columns, out_col_count, tables)
+            .map_or_else(
+                || Some(term.expr.clone()),
+                |slot| join_output_slot_expr(slot, columns, tables),
+            )?;
+        let Expr::Column(col, _) = &expr else {
+            return None;
+        };
+        match resolve_join_column_ref(col.table.as_deref(), &col.column, tables).ok()? {
+            JoinColumnResolution::HiddenRowid(0) => includes_rowid = true,
+            JoinColumnResolution::Column(0, column) => {
+                includes_rowid |= table.columns[column].is_ipk;
+            }
+            _ => return None,
+        }
+        order_by.push(OrderingTerm {
+            expr,
+            direction: term.direction,
+            nulls: term.nulls,
+        });
+    }
+    if !matches!(index_hint, Some(fsqlite_ast::IndexHint::IndexedBy(_)))
+        && let Some(direction) = resolve_order_by_rowid_direction(table, alias, &[], &order_by)
+    {
+        return Some(JoinOuterOrder::Rowid(direction));
+    }
+    if !ctx.index_ordered_scan_reliable {
+        return None;
+    }
+    let plan = resolve_order_by_index_plan(
+        table,
+        alias,
+        &[],
+        None,
+        &order_by,
+        Distinctness::All,
+        index_hint,
+        &[],
+    )?;
+    let unique_order = plan.index.is_unique
+        && order_by.len() >= plan.index.key_term_count()
+        && plan.index.columns.iter().all(|name| {
+            table.column_index(name).is_some_and(|column| {
+                table.columns[column].notnull || table.columns[column].is_ipk
+            })
+        });
+    (includes_rowid || unique_order).then_some(JoinOuterOrder::Index(plan))
+}
