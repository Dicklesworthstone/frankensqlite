+        group_by,
+        ..
+    } = &select.body.select
+    else {
+        return None;
+    };
+    if select.with.is_some() || !select.body.compounds.is_empty() {
+        return None;
+    }
+    let source = |source: &TableOrSubquery| -> Option<(&TableSchema, String)> {
+        let TableOrSubquery::Table {
+            name,
+            alias,
+            time_travel: None,
+            ..
+        } = source
+        else {
+            return None;
+        };
+        if name.schema.is_some() {
+            return None;
+        }
+        let table = schema
+            .iter()
+            .find(|table| table.name.eq_ignore_ascii_case(&name.name))?;
+        Some((table, alias.as_ref().unwrap_or(&name.name).clone()))
+    };
+    let mut roots = HashSet::new();
+    let mut rows = Vec::new();
+    let mut append = |parent: i32, detail: String| -> i32 {
+        let id = i32::try_from(rows.len() + 1).unwrap_or(i32::MAX);
+        rows.push(EqpRow {
+            id,
+            parent,
+            notused: 0,
+            detail,
+        });
+        id
+    };
+    for item in std::iter::once(&from.source).chain(from.joins.iter().map(|join| &join.table)) {
+        let (table, display) = source(item)?;
+        if !roots.insert(table.root_page) {
+            return None;
+        }
+        append(0, native_source_detail(program, table, &display)?);
+    }
+    let mut subquery_number = 0;
+    for column in columns {
+        let ResultColumn::Expr {
+            expr: Expr::Subquery(inner, _),
+            ..
+        } = column
+        else {
+            continue;
+        };
+        let SelectCore::Select {
+            from: Some(inner_from),
+            ..
+        } = &inner.body.select
+        else {
+            return None;
+        };
+        if !inner_from.joins.is_empty() {
+            return None;
+        }
+        let (table, display) = source(&inner_from.source)?;
+        if !roots.insert(table.root_page) {
+            return None;
+        }
+        let detail = native_source_detail(program, table, &display)?;
+        subquery_number += 1;
+        let parent = append(0, format!("CORRELATED SCALAR SUBQUERY {subquery_number}"));
+        append(parent, detail);
+    }
+    if program
+        .ops()
+        .iter()
+        .any(|op| op.opcode == Opcode::SorterOpen)
+    {
+        if !group_by.is_empty() {
+            append(0, "USE TEMP B-TREE FOR GROUP BY".to_owned());
+        } else if !select.order_by.is_empty() {
+            append(0, "USE TEMP B-TREE FOR ORDER BY".to_owned());
+        }
+    }
+    Some(rows)
+}
