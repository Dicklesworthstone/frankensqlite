+        let params: Vec<_> = params.iter().copied().map(SqliteValue::Integer).collect();
+        let prepared = f.prepare(sql).await.unwrap();
+        for rows in [
+            f.query_with_params(sql, &params).await.unwrap(),
+            prepared.query_with_params(&params).await.unwrap(),
+        ] {
+            let actual: Vec<_> = rows.iter().map(|row| row.values().to_vec()).collect();
+            assert_eq!(actual, expected, "{sql}, params={params:?}");
+            for (actual, expected) in actual.iter().flatten().zip(expected.iter().flatten()) {
+                assert_eq!(
+                    std::mem::discriminant(actual),
+                    std::mem::discriminant(expected),
+                    "storage class: {sql}"
+                );
+            }
+        }
+    }
