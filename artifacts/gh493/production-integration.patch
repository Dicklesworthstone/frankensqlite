+#[test]
+fn schema_only_cte_shadow_is_not_an_extra_temp_catalog_object() {
+    asupersync::test_utils::run_test(|| async {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("cte-temp-catalog.db");
+        seed(&path);
+        let conn = Connection::open_existing_schema_only(
+            path.to_string_lossy().as_ref(),
+        ).await.unwrap();
+        conn.execute("CREATE TEMP TABLE c(x INTEGER)").await.unwrap();
+        conn.execute("INSERT INTO temp.c VALUES (41)").await.unwrap();
+        let sql = "WITH c(x) AS MATERIALIZED (VALUES (7)) SELECT c.x, \
+            (SELECT count(*) FROM sqlite_temp_master WHERE name='c'), \
+            (SELECT count(*) FROM sqlite_master WHERE name='c') FROM c";
+        for _ in 0..2 {
+            assert_eq!(query(&conn, sql).await, vec![vec![
+                SqliteValue::Integer(7), SqliteValue::Integer(1), SqliteValue::Integer(0),
+            ]]);
+            assert_eq!(query(&conn, "SELECT x FROM temp.c").await,
+                vec![vec![SqliteValue::Integer(41)]]);
+            assert_bounded(&conn, "catalog enumeration and real TEMP shadow cleanup");
+        }
+        conn.close_without_checkpoint().await.unwrap();
+    });
