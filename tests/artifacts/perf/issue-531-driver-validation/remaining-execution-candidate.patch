+static SERIAL: std::sync::Mutex<()> = std::sync::Mutex::new(());
+fn serial() -> std::sync::MutexGuard<'static, ()> {
+    SERIAL
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+fn stock_value(value: rusqlite::types::Value) -> SqliteValue {
+    match value {
+        rusqlite::types::Value::Null => SqliteValue::Null,
+        rusqlite::types::Value::Integer(v) => SqliteValue::Integer(v),
+        rusqlite::types::Value::Real(v) => SqliteValue::Float(v),
+        rusqlite::types::Value::Text(v) => SqliteValue::Text(v.into()),
+        rusqlite::types::Value::Blob(v) => SqliteValue::Blob(v.into()),
+    }
+}
+fn stock_rows<P: rusqlite::ToSql>(
+    stmt: &mut rusqlite::Statement<'_>,
+    params: &[P],
+) -> Vec<Vec<SqliteValue>> {
+    let columns = stmt.column_count();
+    stmt.query_map(rusqlite::params_from_iter(params), |row| {
+        (0..columns)
+            .map(|column| row.get(column).map(stock_value))
+            .collect()
+    })
+    .expect("stock query")
+    .collect::<rusqlite::Result<_>>()
+    .expect("stock rows")
+}
+fn franken_rows(rows: &[fsqlite_core::connection::Row]) -> Vec<Vec<SqliteValue>> {
+    rows.iter().map(|row| row.values().to_vec()).collect()
+}
+
+fn typed_row(row: &[SqliteValue]) -> Vec<String> {
+    row.iter()
+        .map(|value| match value {
+            SqliteValue::Null => "null".to_owned(),
+            SqliteValue::Integer(value) => format!("integer:{value}"),
+            // Check storage class and the precise represented floating value.
+            SqliteValue::Float(value) => format!("real:{:016x}", value.to_bits()),
+            SqliteValue::Text(value) => format!("text:{value}"),
+            SqliteValue::Blob(value) => format!("blob:{value:?}"),
+        })
+        .collect()
+}
+
+fn assert_rows(
+    actual: Vec<Vec<SqliteValue>>,
+    expected: Vec<Vec<SqliteValue>>,
+    ordered: bool,
+    sql: &str,
+) {
+    // SqliteValue's equality is SQL numeric equality, so comparing it directly
+    // would miss an INTEGER/REAL result-type regression.
+    let mut actual: Vec<_> = actual.iter().map(|row| typed_row(row)).collect();
+    let mut expected: Vec<_> = expected.iter().map(|row| typed_row(row)).collect();
+    if !ordered {
+        actual.sort_unstable();
+        expected.sort_unstable();
+    }
+    assert_eq!(actual, expected, "{sql}");
+}
