+/// GH#533: lower a transparent, single-reference table-function CTE through
+/// the established derived-table flattener. Called only after the original
+/// statement's lexical preflight, so unused projected columns are validated
+/// before a consumer such as count(*) can eliminate them.
+fn flatten_single_use_table_function_cte(select: &SelectStatement) -> Option<SelectStatement> {
+    let with = select.with.as_ref()?;
+    if with.recursive || with.ctes.len() != 1 {
+        return None;
+    }
+    let cte = &with.ctes[0];
+    // Explicit hints retain their own execution policy. In particular the
+    // existing NOT MATERIALIZED rewriter owns repeated and chained references.
+    if cte.materialized.is_some()
+        || cte.query.with.is_some()
+        || !cte.query.body.compounds.is_empty()
+        || !cte.query.order_by.is_empty()
+        || cte.query.limit.is_some()
+    {
+        return None;
+    }
+    let SelectCore::Select {
+        distinct: Distinctness::All,
+        columns,
+        from: Some(body_from),
+        where_clause: body_filter,
+        group_by,
+        having: None,
+        windows,
+    } = &cte.query.body.select
+    else {
+        return None;
+    };
+    let TableOrSubquery::TableFunction { args, .. } = &body_from.source else {
+        return None;
+    };
+    // Copy only column projections: flattening must not omit or duplicate a
+    // volatile projected expression, or expose a hidden column through `*`.
+    // Stable source arguments exclude callbacks and correlated expressions.
+    if !body_from.joins.is_empty()
+        || !group_by.is_empty()
+        || !windows.is_empty()
+        || !columns.iter().all(|column| {
+            matches!(
+                column,
+                ResultColumn::Expr {
+                    expr: Expr::Column(..),
+                    ..
+                }
+            )
+        })
+        || !args.iter().all(|expr| transparent_cte_expr(expr, false))
+        || body_filter
+            .as_deref()
+            .is_some_and(|expr| !transparent_cte_expr(expr, true))
+    {
+        return None;
+    }
+
+    let mut derived = select.clone();
+    derived.with = None;
+    let mut references = 0usize;
+    visit_select_qualified_names(&derived, &mut |name| {
+        if name.schema.is_none() && name.name.eq_ignore_ascii_case(&cte.name) {
+            references += 1;
+        }
+        Ok(())
+    })
+    .ok()?;
+    if references != 1
+        || derived
+            .order_by
+            .iter()
+            .any(|term| !transparent_cte_expr(&term.expr, true))
+        || derived.limit.as_ref().is_some_and(|limit| {
+            !transparent_cte_expr(&limit.limit, false)
+                || limit
+                    .offset
+                    .as_ref()
+                    .is_some_and(|expr| !transparent_cte_expr(expr, false))
+        })
+    {
+        return None;
+    }
+    let SelectCore::Select {
+        columns,
+        from: Some(from),
+        where_clause,
+        ..
+    } = &mut derived.body.select
+    else {
+        return None;
+    };
+    if !columns.iter().all(transparent_cte_consumer_column)
+        || where_clause
+            .as_deref()
+            .is_some_and(|expr| !transparent_cte_expr(expr, true))
+    {
+        return None;
+    }
+    let TableOrSubquery::Table {
+        name,
+        alias,
+        index_hint: None,
+        time_travel: None,
+    } = &from.source
+    else {
+        return None;
+    };
+    if name.schema.is_some() || !name.name.eq_ignore_ascii_case(&cte.name) {
+        return None;
+    }
+    let alias = alias.clone().unwrap_or_else(|| name.name.clone());
+    from.source = TableOrSubquery::Subquery {
+        query: Box::new(cte_inline_body(cte)?),
+        alias: Some(alias),
+    };
+    // The established strict map preserves the CTE's exposed names and alias,
+    // declines ambiguous projections, and keeps all semantic barriers. It
+    // never resolves an unexposed name against the underlying virtual table.
+    flatten_from_subquery_select(&derived, true)
+}
