+/// Joined scalar projections currently admit only the existing COUNT(*)
+/// kernel. Keep its structural contract here as well as in the connection's
+/// lexical and function-registry admission checks: the generic aggregate
+/// emitter does not implement grouped or limited scalar aggregates.
+fn emit_join_scalar_count_subquery(
+    b: &mut ProgramBuilder,
+    subquery: &SelectStatement,
+    reg: i32,
+    tables: &[(&TableSchema, Option<&str>)],
+    schema: &[TableSchema],
+) -> Result<(), CodegenError> {
+    let SelectCore::Select {
+        columns,
+        from: Some(from),
+        group_by,
+        having,
+        windows,
+        ..
+    } = &subquery.body.select
+    else {
+        return Err(CodegenError::Unsupported(
+            "join scalar projection requires COUNT(*) from a table".to_owned(),
+        ));
+    };
+    if subquery.with.is_some()
+        || !subquery.body.compounds.is_empty()
+        || !subquery.order_by.is_empty()
+        || subquery.limit.is_some()
+        || !is_simple_count_star(columns)
+        || !group_by.is_empty()
+        || having.is_some()
+        || !windows.is_empty()
+        || !from.joins.is_empty()
+        || !matches!(&from.source, TableOrSubquery::Table {
+            name,
+            index_hint: None,
+            time_travel: None,
+            ..
+        } if name.schema.is_none())
