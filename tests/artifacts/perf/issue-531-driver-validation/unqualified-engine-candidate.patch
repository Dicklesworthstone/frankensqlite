+                details.contains(&"USE TEMP B-TREE FOR GROUP BY"),
+                "{sql}: {details:?}"
+            );
+            assert!(
+                !details.contains(&"USE TEMP B-TREE FOR ORDER BY"),
+                "{sql}: {details:?}"
+            );
+        }
+        for (sql, expected) in [
+            (
+                "SELECT p.id,u.username FROM posts p JOIN users u ON u.id=p.user_id WHERE p.id=?1",
+                "SEARCH p USING INTEGER PRIMARY KEY (rowid=?)",
+            ),
+            (
+                "SELECT p.id,u.username FROM posts p JOIN users u ON u.id=p.user_id ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+                "SCAN p USING INDEX posts_created_at_id_idx",
+            ),
+        ] {
+            let rows = f.query(&format!("EXPLAIN QUERY PLAN {sql}")).await.unwrap();
+            let details: Vec<&str> = rows
+                .iter()
+                .map(|row| row.values()[3].as_text().unwrap())
+                .collect();
+            assert!(details.contains(&expected), "{sql}: {details:?}");
+            assert!(
+                details.contains(&"SEARCH u USING INTEGER PRIMARY KEY (rowid=?)"),
+                "{sql}: {details:?}"
+            );
+            assert!(
+                !details.contains(&"USE TEMP B-TREE FOR ORDER BY"),
+                "{sql}: {details:?}"
+            );
+        }
+        for sql in [
+            "SELECT p.id,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) FROM posts p ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+            "SELECT p.id,u.username,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) FROM posts p JOIN users u ON u.id=p.user_id WHERE p.id=?1",
+        ] {
+            let rows = f.query(&format!("EXPLAIN QUERY PLAN {sql}")).await.unwrap();
+            let parent = rows
+                .iter()
+                .find(|row| {
+                    row.values()[3]
+                        .as_text()
+                        .is_some_and(|detail| detail.starts_with("CORRELATED SCALAR SUBQUERY"))
+                })
+                .unwrap_or_else(|| panic!("missing scalar scope: {sql}: {rows:?}"));
+            assert!(
+                rows.iter().any(|row| row.values()[1] == parent.values()[0]
+                    && row.values()[3].as_text().is_some_and(|detail| {
+                        detail.starts_with("SEARCH l USING") && detail.contains("likes_post_id_idx")
+                    })),
+                "missing indexed scalar child: {sql}: {rows:?}"
+            );
+        }
+    });
+}
