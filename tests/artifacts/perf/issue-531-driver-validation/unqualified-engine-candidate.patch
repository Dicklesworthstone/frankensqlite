+
+    impl fsqlite_func::collation::CollationFunction for CountProbeCollation {
+        fn name(&self) -> &str {
+            "gh531_cmp"
+        }
+
+        fn compare(&self, left: &[u8], right: &[u8]) -> std::cmp::Ordering {
+            if self.fold_ascii {
+                left.to_ascii_lowercase().cmp(&right.to_ascii_lowercase())
+            } else {
+                left.cmp(right)
+            }
+        }
+    }
