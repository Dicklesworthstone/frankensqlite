+            "SELECT t.id, k.label FROM t LEFT JOIN k ON k.g = t.g ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t LEFT JOIN k ON k.g = t.g WHERE k.label IS NULL ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t LEFT JOIN k ON k.g = t.g AND t.n > 2 ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t JOIN k ON k.g = t.g WHERE t.n > 1 AND k.label <> 'k3' ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, u.w FROM t LEFT JOIN u ON u.tid = t.id ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t LEFT JOIN empty_k AS k ON k.g = t.g ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t JOIN empty_k AS k ON k.g = t.g ORDER BY t.n DESC, t.id DESC",
+            "SELECT t.id, k.label FROM t JOIN k ON k.g = t.g ORDER BY t.id DESC",
+            "SELECT t.id, k.label FROM t JOIN k ON k.g = t.g ORDER BY t.rowid DESC",
+            "SELECT t.n AS id, t.id AS n, k.label FROM t JOIN k ON k.g = t.g ORDER BY id DESC, n DESC",
+            "SELECT * FROM t JOIN k ON k.g = t.g ORDER BY 4 DESC, 1 DESC",
+            "SELECT t.*, k.label FROM t JOIN k ON k.g = t.g ORDER BY 4 DESC, 1 DESC",
+            // Ordering by the inner side or an expression keeps a bounded sorter.
