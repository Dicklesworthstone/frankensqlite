+INSERT INTO posts VALUES(1,1,'first','b'),(2,99,'missing','Z'),(3,2,'third','A'),(4,1,'fourth','a'),(5,NULL,'null',NULL),(6,2,'sixth','C');
+INSERT INTO likes VALUES(1,1),(2,1),(1,3),(2,3),(3,3),(2,4),(2,6),(NULL,6),(5,NULL);
+";
