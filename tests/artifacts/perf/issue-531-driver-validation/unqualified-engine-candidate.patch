+    #[test]
+    fn secondary_numeric_correlation_keeps_typeless_index_fallback() {
+        const SETUP: &str = "
+            CREATE TABLE posts(id INTEGER PRIMARY KEY, user_id INTEGER);
+            CREATE TABLE users(id INTEGER PRIMARY KEY, n NUMERIC);
+            CREATE TABLE mixed(k);
+            CREATE INDEX mixed_k ON mixed(k);
+            INSERT INTO posts VALUES(10,1),(20,2);
+            INSERT INTO users VALUES(1,1),(2,2);
+            INSERT INTO mixed VALUES('1'),(1),(1.0),('01'),('1.0'),('2'),(NULL),(x'31');
+        ";
+        const SQL: &str = "SELECT p.id,u.n, \
+            (SELECT count(*) FROM mixed l WHERE l.k=u.n) \
+            FROM posts p JOIN users u ON u.id=p.user_id ORDER BY p.id LIMIT ?1";
+        asupersync::test_utils::run_test(|| async {
+            for file_backed in [false, true] {
+                let dir = tempfile::tempdir().unwrap();
+                let path = dir.path().join("secondary-affinity.db");
+                let path = if file_backed {
+                    path.to_str().unwrap()
+                } else {
+                    ":memory:"
+                };
+                let mut f = Connection::open(path).await.unwrap();
+                f.execute_batch(SETUP).await.unwrap();
+                if file_backed {
+                    f.close().await.unwrap();
+                    f = Connection::open(path).await.unwrap();
+                }
+                let stock = rusqlite::Connection::open_in_memory().unwrap();
+                stock.execute_batch(SETUP).unwrap();
+                // u.n contributes NUMERIC affinity: TEXT '1', INTEGER 1,
+                // REAL 1.0 and alternate numeric spellings all match. A
+                // raw seek of typeless mixed.k cannot cover that comparison.
+                // Validating u.n against unrelated p would lose its affinity.
+                f.set_reject_mem_fallback(true);
+                f.set_strict_mem_fallback_rejection(true);
+                assert!(
+                    f.query_with_params(SQL, &[SqliteValue::Integer(20)])
+                        .await
+                        .is_err(),
+                    "an unseekable secondary correlation must retain its fallback"
+                );
+                f.set_strict_mem_fallback_rejection(false);
+                f.set_reject_mem_fallback(false);
+                assert_matches(&stock, &f, SQL, &[20]).await;
+                assert_matches(&stock, &f, SQL, &[1]).await;
+                f.close().await.unwrap();
+            }
+        });
+    }
