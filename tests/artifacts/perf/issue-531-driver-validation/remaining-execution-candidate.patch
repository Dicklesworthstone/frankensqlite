+#[test]
+fn bounded_scalar_projection_work_matches_stock() {
+    let _serial = serial();
+    asupersync::test_utils::run_test(|| async {
+        let directory = tempfile::tempdir().unwrap();
+        let stock_path = directory.path().join("stock.db");
+        let franken_path = directory.path().join("franken.db");
+        seed(&stock_path, 20_000);
+        std::fs::copy(&stock_path, &franken_path).unwrap();
+        let r = rusqlite::Connection::open(&stock_path).unwrap();
+        let f = Connection::open(franken_path.to_str().unwrap())
+            .await
+            .unwrap();
+        for case in cases(20_000)
+            .into_iter()
+            .filter(|case| case.name.contains("correlated"))
+        {
+            let expected = stock_rows(&mut r.prepare(&case.sql).unwrap(), &case.params);
+            let statement = f.prepare(&case.sql).await.unwrap();
+            let params: Vec<_> = case
+                .params
+                .iter()
+                .copied()
+                .map(SqliteValue::Integer)
+                .collect();
+            set_hot_path_profile_enabled(true);
+            reset_hot_path_profile();
+            let actual = statement.query_with_params(&params).await.unwrap();
+            let work = hot_path_profile_snapshot().vdbe.opcodes_executed_total;
+            set_hot_path_profile_enabled(false);
+            assert_rows(franken_rows(&actual), expected, case.ordered, &case.sql);
+            assert!(
+                work > 0 && work < 10_000,
+                "{} executed excessive VM work: {work}",
+                case.name
+            );
+        }
+        let control = "SELECT p.id,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) FROM posts p NOT INDEXED ORDER BY p.created_at DESC,p.id DESC LIMIT 20";
+        set_hot_path_profile_enabled(true);
+        reset_hot_path_profile();
+        let actual = f.query(control).await.unwrap();
+        let work = hot_path_profile_snapshot().vdbe.opcodes_executed_total;
+        set_hot_path_profile_enabled(false);
+        assert_rows(
+            franken_rows(&actual),
+            stock_rows(&mut r.prepare(control).unwrap(), &[] as &[i64]),
+            true,
+            control,
+        );
+        assert!(
+            work >= 20_000,
+            "full scan must make counter observe input work: {work}"
+        );
+        f.close().await.unwrap();
+    });
+}
