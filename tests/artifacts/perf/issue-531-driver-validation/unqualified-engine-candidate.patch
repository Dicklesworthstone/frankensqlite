+/// Emit the existing indexed COUNT(*) scalar kernel in a joined FROM scope.
+/// Connection admission checks bindings, the builtin registry and seek safety;
+/// retain the kernel's structural contract here for direct codegen callers too.
+fn emit_join_scalar_count_subquery(
+    b: &mut ProgramBuilder,
+    subquery: &SelectStatement,
+    reg: i32,
+    tables: &[(&TableSchema, Option<&str>)],
+    schema: &[TableSchema],
+) -> Result<(), CodegenError> {
+    let SelectCore::Select {
+        columns,
+        from: Some(from),
+        group_by,
+        having,
+        windows,
+        ..
+    } = &subquery.body.select
+    else {
+        return Err(CodegenError::Unsupported(
+            "join scalar projection requires COUNT(*) from a table".to_owned(),
+        ));
+    };
+    if subquery.with.is_some()
+        || !subquery.body.compounds.is_empty()
+        || !subquery.order_by.is_empty()
+        || subquery.limit.is_some()
+        || !is_simple_count_star(columns)
+        || !group_by.is_empty()
+        || having.is_some()
+        || !windows.is_empty()
+        || !from.joins.is_empty()
+        || !matches!(&from.source, TableOrSubquery::Table {
+            name,
+            index_hint: None,
+            time_travel: None,
+            ..
+        } if name.schema.is_none())
+    {
+        return Err(CodegenError::Unsupported(
+            "unsupported join scalar COUNT(*) shape".to_owned(),
+        ));
+    }
+    let Some(&(table, alias)) = tables.first() else {
+        return Err(CodegenError::Unsupported(
+            "join scalar subquery without an outer table".to_owned(),
+        ));
+    };
+    let secondaries: Vec<_> = (1_i32..)
+        .zip(tables.iter().skip(1))
+        .map(|(cursor, (table, alias))| SecondaryScan {
+            cursor,
+            table,
+            table_alias: *alias,
+            register_base: None,
+        })
+        .collect();
+    let outer_ctx = ScanCtx {
+        cursor: 0,
+        table,
+        table_alias: alias,
+        schema: Some(schema),
+        register_base: None,
+        secondaries: &secondaries,
+    };
+    emit_scalar_subquery(b, subquery, reg, &outer_ctx, schema);
+    Ok(())
+}
