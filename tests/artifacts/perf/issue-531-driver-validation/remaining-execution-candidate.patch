+                    .then_some(op.p1)
+                })
+                .expect("outer ordering index");
+            assert!(
+                index_cursor <= 5,
+                "{sql}: outer index cursor {index_cursor} must not grow the dense cursor table"
+            );
+            for opcode in [
+                if reverse {
+                    Opcode::Last
+                } else {
+                    Opcode::Rewind
+                },
+                if reverse { Opcode::Prev } else { Opcode::Next },
+                Opcode::IdxRowid,
+            ] {
+                assert!(
+                    ops.iter()
+                        .any(|op| op.opcode == opcode && op.p1 == index_cursor),
+                    "{sql}"
+                );
+            }
+            assert!(
+                !ops.iter().any(|op| op.opcode == Opcode::SorterOpen),
+                "{sql}"
+            );
+            let output = ops
+                .iter()
+                .position(|op| op.opcode == Opcode::ResultRow)
+                .unwrap();
+            assert_eq!(ops[output + 1].opcode, Opcode::DecrJumpZero, "{sql}");
+            assert_eq!(program.max_bind_parameter_index().unwrap(), 2);
+        }
+    }
+}
