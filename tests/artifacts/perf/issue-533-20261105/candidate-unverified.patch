+    #[test]
+    fn gh533_series_override_keeps_its_callbacks_and_values() {
+        asupersync::test_utils::run_test(|| async {
+            let conn = Connection::open(":memory:").await.unwrap();
+            CALLBACKS.with(|state| {
+                state.set(CallbackState {
+                    value_offset: 100,
+                    ..Default::default()
+                })
+            });
+            conn.register_module(
+                "generate_series",
+                Box::new(module_factory_from::<CountingSeriesTable>()),
+            );
+            assert!(
+                conn.try_table_function_exists_probe(&select(
+                    "SELECT 1 FROM generate_series(1,4) WHERE value=101"
+                ))
+                .is_none()
+            );
+            reset_cursor_work();
+            assert_eq!(
+                count(
+                    &conn,
+                    "SELECT count(*) FROM generate_series(1,4) t WHERE EXISTS \
+                 (SELECT 1 FROM generate_series(1,4) s WHERE s.value=t.value)"
+                )
+                .await,
+                4,
+                "both sources must use the override's 101..=104 values"
+            );
+            assert_eq!(
+                EXISTS_CURSOR_WORK.with(Cell::get),
+                ExistsCursorWork::default()
+            );
+            let callbacks = CALLBACKS.with(Cell::get);
+            assert!(callbacks.filters > 1);
+            assert_eq!(
+                callbacks.best_indexes, 0,
+                "override retains its positional table-function protocol"
+            );
+            assert_eq!(callbacks.connects, callbacks.disconnects);
+            assert_eq!(callbacks.filters, callbacks.cursor_drops);
+            assert!(!callbacks.disconnect_before_cursor_drop);
+
+            CALLBACKS.with(|state| {
+                state.set(CallbackState {
+                    fail_column: true,
+                    ..Default::default()
+                })
+            });
+            let error = conn
+                .query(
+                    "WITH t(v) AS (VALUES(1)) SELECT count(*) FROM t WHERE EXISTS \
+                 (SELECT 1 FROM generate_series(1,4) s WHERE s.value=t.v)",
+                )
+                .await
+                .unwrap_err()
+                .to_string();
+            assert!(error.contains("test column failure"), "{error}");
+            let callbacks = CALLBACKS.with(Cell::get);
+            assert_eq!(callbacks.connects, callbacks.disconnects);
+            assert_eq!(callbacks.filters, callbacks.cursor_drops);
+            assert!(!callbacks.disconnect_before_cursor_drop);
+        });
+    }
