 impl BusyTimeoutScope {
+    /// Own a window around a retry future, including entry points that bypass
+    /// the attributed statement dispatcher. Pinning here needs no allocation.
+    /// The connection slot is restored before a poll returns, including Pending.
+    pub(super) async fn scope<F: Future>(&self, future: F) -> F::Output {
+        let owned = Cell::new(BusyTimeoutState::Unstarted);
+        let mut future = std::pin::pin!(future);
+        poll_fn(|cx| {
+            let _poll = self.enter_poll(&owned);
+            future.as_mut().poll(cx)
+        })
+        .await
+    }
+
