{
  "name": "@frankensqlite/worker",
  "version": "0.3.0",
  "description": "Worker host and protocol for FrankenSQLite WebAssembly bindings",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dicklesworthstone/frankensqlite.git",
    "directory": "packages/worker"
  },
  "homepage": "https://github.com/Dicklesworthstone/frankensqlite/tree/main/packages/worker#readme",
  "bugs": {
    "url": "https://github.com/Dicklesworthstone/frankensqlite/issues"
  },
  "type": "module",
  "main": "./dist/npm/index.cjs",
  "types": "./dist/npm/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/npm/index.js",
      "import": { "types": "./dist/npm/index.d.ts", "default": "./dist/npm/index.js" },
      "require": { "types": "./dist/npm/index.d.cts", "default": "./dist/npm/index.cjs" }
    },
    "./protocol": {
      "browser": "./dist/npm/protocol.js",
      "import": { "types": "./dist/npm/protocol.d.ts", "default": "./dist/npm/protocol.js" },
      "require": { "types": "./dist/npm/protocol.d.cts", "default": "./dist/npm/protocol.cjs" }
    },
    "./worker": {
      "browser": "./dist/npm/worker.js",
      "import": { "types": "./dist/npm/worker.d.ts", "default": "./dist/npm/worker.js" },
      "require": { "types": "./dist/npm/worker.d.cts", "default": "./dist/npm/worker.cjs" }
    }
  },
  "files": [
    "dist/npm",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@frankensqlite/core": "^0.3.0 || ^0.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && tsdown --config ../../tsdown.config.mts src/index.ts src/protocol.ts src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run typecheck && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
