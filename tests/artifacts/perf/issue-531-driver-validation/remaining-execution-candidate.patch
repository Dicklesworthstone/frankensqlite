+/// Published CLI seed, scaled by row counts. Attempted inserts repeat primary
+/// keys: the default fixture has 500,000 distinct likes, not two million.
+fn seed(path: &std::path::Path, posts: usize) {
+    assert!(posts >= 100 && posts.is_multiple_of(10));
+    let users = posts / 10;
+    let r = rusqlite::Connection::open(path).unwrap();
+    r.execute_batch(&format!(
+        "PRAGMA journal_mode=OFF; PRAGMA synchronous=OFF;
+         CREATE TABLE users(id INTEGER PRIMARY KEY,username TEXT NOT NULL UNIQUE);
+         CREATE TABLE posts(id INTEGER PRIMARY KEY,user_id INTEGER NOT NULL,body TEXT NOT NULL,created_at TEXT NOT NULL);
+         CREATE TABLE likes(user_id INTEGER NOT NULL,post_id INTEGER NOT NULL,PRIMARY KEY(user_id,post_id));
+         CREATE INDEX posts_created_at_id_idx ON posts(created_at DESC,id DESC);
+         CREATE INDEX likes_post_id_idx ON likes(post_id);
+         WITH RECURSIVE n(i) AS(SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<{users}) INSERT INTO users SELECT i,'user'||i FROM n;
+         WITH RECURSIVE n(i) AS(SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<{posts}) INSERT INTO posts SELECT i,i*48271%{users}+1,'post body '||i,printf('2025-%02d-%02dT%02d:%02d:%02d.%03dZ',i%12+1,i%28+1,i%24,i%60,i/7%60,i%1000) FROM n;
+         WITH RECURSIVE n(i) AS(SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<{attempts}) INSERT OR IGNORE INTO likes SELECT i*48271%{users}+1,i*16807%{posts}+1 FROM n;
+         ANALYZE; VACUUM; PRAGMA journal_mode=WAL;",attempts=4*posts,
+    )).unwrap();
+}
+struct Case {
+    name: &'static str,
+    sql: String,
+    params: Vec<i64>,
+    ordered: bool,
+}
+fn cases(posts: usize) -> Vec<Case> {
+    let point = i64::try_from(posts * 4 / 5).unwrap();
+    let mut result = Vec::new();
+    for (name, sql, params, ordered) in [
+        (
+            "group_eq",
+            "SELECT post_id,count(*) FROM likes WHERE post_id=?1 GROUP BY post_id",
+            vec![point],
+            false,
+        ),
+        (
+            "group_eq_residual",
+            "SELECT post_id,count(*) FROM likes WHERE post_id=?1 AND user_id>?2 GROUP BY post_id",
+            vec![point, 0],
+            false,
+        ),
+        (
+            "count_eq_control",
+            "SELECT count(*) FROM likes WHERE post_id=?1",
+            vec![point],
+            false,
+        ),
+        (
+            "newest20_control",
+            "SELECT p.id FROM posts p ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+            vec![],
+            true,
+        ),
+        (
+            "join_newest20",
+            "SELECT p.id,u.username FROM posts p JOIN users u ON u.id=p.user_id ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+            vec![],
+            true,
+        ),
+        (
+            "correlated_newest20",
+            "SELECT p.id,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) FROM posts p ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+            vec![],
+            true,
+        ),
+        (
+            "join_by_id_control",
+            "SELECT p.id,p.body,p.created_at,u.username FROM posts p JOIN users u ON u.id=p.user_id WHERE p.id=?1",
+            vec![point],
+            false,
+        ),
+        (
+            "correlated_by_id_control",
+            "SELECT p.id,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) FROM posts p WHERE p.id=?1",
+            vec![point],
+            false,
+        ),
+        (
+            "join_correlated_by_id",
+            "SELECT p.id,p.body,p.created_at,u.username,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) AS like_count FROM posts p JOIN users u ON u.id=p.user_id WHERE p.id=?1",
+            vec![point],
+            false,
+        ),
+        (
+            "join_correlated_newest20",
+            "SELECT p.id,p.body,p.created_at,u.username,(SELECT count(*) FROM likes l WHERE l.post_id=p.id) AS like_count FROM posts p JOIN users u ON u.id=p.user_id ORDER BY p.created_at DESC,p.id DESC LIMIT 20",
+            vec![],
+            true,
+        ),
+    ] {
+        result.push(Case {
+            name,
+            sql: sql.to_owned(),
+            params,
+            ordered,
+        });
+    }
+    result.push(Case {
+        name: "group_in20",
