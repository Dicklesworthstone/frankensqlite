+                    !conn.memdb_rows_loaded.get(),
+                    "unrelated persistent rows stay unhydrated"
+                );
+                assert!(
+                    conn.materialized_temp_root_pages.borrow().is_empty(),
+                    "statement-owned roots are cleaned up"
+                );
+            }
+            assert_eq!(
+                count(
+                    &conn,
+                    "WITH t AS MATERIALIZED (SELECT value FROM generate_series(1,128)) \
+                 SELECT count(*) FROM t WHERE EXISTS(SELECT 1 FROM t t1 \
+                 WHERE t.value=t1.value AND t1.value%2=0)"
+                )
+                .await,
+                64,
+                "residual filters retain their ordinary execution route"
+            );
+            assert!(!conn.memdb_rows_loaded.get());
+            for (sql, expected) in [
+                (
+                    "WITH c(x) AS MATERIALIZED (VALUES(1),(2),(3)) \
+                     SELECT count(*) FROM generate_series(1,20) p \
+                     WHERE EXISTS(SELECT 1 FROM c WHERE c.x=p.value) \
+                     OR EXISTS(WITH c(x) AS MATERIALIZED (VALUES(5),(6),(7)) \
+                     SELECT 1 FROM c WHERE c.x=p.value)",
+                    6,
+                ),
+                (
+                    "SELECT sum((WITH c(x) AS MATERIALIZED \
+                     (SELECT o.value+value FROM generate_series(1,3)) \
+                     SELECT count(*) FROM generate_series(1,12) p \
+                     WHERE EXISTS(SELECT 1 FROM c WHERE c.x=p.value))) \
+                     FROM generate_series(1,5) o",
+                    15,
+                ),
+            ] {
+                assert_eq!(
+                    count(&conn, sql).await,
+                    expected,
+                    "CTE roots follow their lexical lifetimes: {sql}"
+                );
+                assert!(conn.materialized_temp_root_pages.borrow().is_empty());
+            }
+        });
+    }
