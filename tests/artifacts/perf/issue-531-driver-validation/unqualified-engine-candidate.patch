+        };
+        if !inner_from.joins.is_empty() {
+            return None;
+        }
+        let (table, display) = source(&inner_from.source)?;
+        if !roots.insert(table.root_page) {
+            return None;
+        }
+        let detail = native_source_detail(program, table, &display)?;
+        subquery_number += 1;
+        let parent = append(0, format!("CORRELATED SCALAR SUBQUERY {subquery_number}"));
+        append(parent, detail);
+    }
+    if program
+        .ops()
+        .iter()
+        .any(|op| op.opcode == Opcode::SorterOpen)
+    {
+        if !group_by.is_empty() {
+            append(0, "USE TEMP B-TREE FOR GROUP BY".to_owned());
+        } else if !select.order_by.is_empty() {
+            append(0, "USE TEMP B-TREE FOR ORDER BY".to_owned());
+        }
+    }
+    Some(rows)
