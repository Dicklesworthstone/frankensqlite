+#[derive(Default)]
+#[allow(clippy::struct_excessive_bools)] // Independent facts, not mutually exclusive states.
+struct CursorAccess {
+    positioned: bool,
+    full_scan: bool,
+    key_seek: bool,
+    rowid_seek: bool,
+}
+
+/// Inspect each lifetime of a cursor opened on a particular persistent root.
+/// Subquery code can reuse a cursor number for a different table later in the
+/// program, so facts must stop at the next OpenRead of that cursor.
+fn root_access(program: &VdbeProgram, root_page: i32) -> CursorAccess {
+    let mut facts = CursorAccess::default();
+    let ops = program.ops();
+    for (start, open) in ops.iter().enumerate() {
+        if open.opcode != Opcode::OpenRead || open.p2 != root_page {
+            continue;
+        }
+        let tail = &ops[start + 1..];
+        let end = tail
+            .iter()
+            .position(|op| {
+                matches!(op.opcode, Opcode::OpenRead | Opcode::OpenWrite) && op.p1 == open.p1
+            })
+            .unwrap_or(tail.len());
+        for op in &tail[..end] {
+            if op.p1 != open.p1 {
+                continue;
+            }
+            match op.opcode {
+                Opcode::Rewind | Opcode::Last => {
+                    facts.positioned = true;
+                    facts.full_scan = true;
+                }
+                Opcode::SeekGE
+                | Opcode::SeekGT
+                | Opcode::SeekLE
+                | Opcode::SeekLT
+                | Opcode::NoConflict
+                | Opcode::NotFound => {
+                    facts.positioned = true;
+                    facts.key_seek = true;
+                }
+                Opcode::SeekRowid | Opcode::NotExists => {
+                    facts.positioned = true;
+                    facts.rowid_seek = true;
+                }
+                Opcode::Count => facts.positioned = true,
+                _ => {}
+            }
+        }
+    }
+    facts
+}
+
+fn native_source_detail(
+    program: &VdbeProgram,
+    table: &TableSchema,
+    display: &str,
+) -> Option<String> {
+    let table_access = root_access(program, table.root_page);
+    let mut indexes = table.indexes.iter().filter_map(|index| {
+        let facts = root_access(program, index.root_page);
+        facts.positioned.then_some((index, facts))
+    });
+    if let Some((index, facts)) = indexes.next() {
+        // Multiple indexes, or a table-scan alternative to an index seek,
+        // need a richer plan tree. Do not call an ambiguous access SEARCH.
+        if indexes.next().is_some() || table_access.full_scan {
+            return None;
+        }
+        let action = if facts.key_seek && !facts.full_scan {
+            "SEARCH"
+        } else {
+            "SCAN"
+        };
+        let covering = if table_access.positioned {
+            ""
+        } else {
+            "COVERING "
+        };
+        return Some(format!(
+            "{action} {display} USING {covering}INDEX {}",
+            index.name
+        ));
+    }
+    if table_access.full_scan {
+        Some(format!("SCAN {display}"))
+    } else if table_access.rowid_seek && !table.without_rowid {
+        Some(format!(
+            "SEARCH {display} USING INTEGER PRIMARY KEY (rowid=?)"
+        ))
+    } else if table_access.key_seek {
+        Some(format!("SEARCH {display} USING PRIMARY KEY"))
+    } else if table_access.positioned {
+        Some(format!("SCAN {display}"))
+    } else {
+        None
+    }
+}
