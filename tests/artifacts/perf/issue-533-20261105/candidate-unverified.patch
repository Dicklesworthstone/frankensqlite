+/// Expressions without callbacks or clock reads that can cross a transparent
+/// CTE projection. Functions, collations and subqueries also decline;
+/// table-function arguments additionally cannot read an outer column.
+fn transparent_cte_expr(expr: &Expr, allow_columns: bool) -> bool {
+    match expr {
+        Expr::Literal(
+            Literal::CurrentTime | Literal::CurrentDate | Literal::CurrentTimestamp,
+            _,
+        ) => false,
+        Expr::Literal(..) | Expr::Placeholder(..) => true,
+        Expr::Column(..) => allow_columns,
+        Expr::UnaryOp { expr, .. }
+        | Expr::Cast { expr, .. }
+        | Expr::IsNull { expr, .. } => transparent_cte_expr(expr, allow_columns),
+        Expr::BinaryOp { left, right, .. } => {
+            transparent_cte_expr(left, allow_columns) && transparent_cte_expr(right, allow_columns)
+        }
+        _ => false,
+    }
+}
+
+/// The connection gate proves no scalar/aggregate replacement is installed.
+/// Keep all other function calls, including volatile builtins, on the original
+/// execution path instead of moving them across the materialization boundary.
+fn transparent_cte_consumer_column(column: &ResultColumn) -> bool {
+    let ResultColumn::Expr { expr, .. } = column else {
+        return true;
+    };
+    if transparent_cte_expr(expr, true) {
+        return true;
+    }
+    let Expr::FunctionCall {
+        name,
+        args,
+        distinct: false,
+        order_by,
+        filter: None,
+        over: None,
+        ..
+    } = expr
+    else {
+        return false;
+    };
+    order_by.is_empty()
+        && matches!(
+            name.to_ascii_lowercase().as_str(),
+            "count" | "sum" | "avg" | "min" | "max"
+        )
+        && match args {
+            FunctionArgs::Star => name.eq_ignore_ascii_case("count"),
+            FunctionArgs::List(args) => args.len() == 1 && transparent_cte_expr(&args[0], true),
+        }
+}
