+    #[test]
+    fn gh533_cte_memo_declines_ambiguous_text_and_keeps_numeric_blob_oracles() {
+        asupersync::test_utils::run_test(|| async {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("cte_affinity.db");
+            let stock = rusqlite::Connection::open(&path).unwrap();
+            stock.execute_batch("CREATE TABLE unrelated(v);").unwrap();
+            let conn = Connection::open_existing_schema_only(path.to_string_lossy().into_owned())
+                .await
+                .unwrap();
+            for equality in ["c.x=p.y", "p.y=c.x", "c.x=p.y AND c.x>0"] {
+                FSQLITE_EXISTS_PROBE_MEMO_BUILDS.with(|count| count.set(0));
+                FSQLITE_EXISTS_PROBE_MEMO_HITS.with(|count| count.set(0));
+                let sql = format!(
+                    "WITH c(x) AS MATERIALIZED (VALUES(1)), \
+                     p(y) AS MATERIALIZED (SELECT CAST(value AS TEXT) FROM generate_series(1,4)) \
+                     SELECT count(*) FROM p WHERE EXISTS(SELECT 1 FROM c WHERE {equality})"
+                );
+                // This is an admission guard. Materialized expression/TEXT
+                // affinity already differs from stock on the old route; do
+                // not turn its known wrong result into a regression oracle.
+                conn.query(&sql).await.unwrap();
+                assert_eq!(FSQLITE_EXISTS_PROBE_MEMO_BUILDS.with(Cell::get), 0, "{sql}");
+                assert_eq!(FSQLITE_EXISTS_PROBE_MEMO_HITS.with(Cell::get), 0, "{sql}");
+            }
+            for sql in [
+                "WITH c(x) AS MATERIALIZED (SELECT CAST(1 AS NUMERIC)), \
+                 p(y) AS MATERIALIZED (VALUES(1),(2),(3),(4)) \
+                 SELECT count(*) FROM p WHERE EXISTS(SELECT 1 FROM c WHERE c.x=p.y)",
+                "WITH c(x) AS MATERIALIZED (VALUES(1)), \
+                 p(y) AS MATERIALIZED (VALUES(1),(1.0),('1'),(NULL)) \
+                 SELECT count(*) FROM p WHERE EXISTS(SELECT 1 FROM c WHERE p.y=c.x)",
+                "WITH c(x) AS MATERIALIZED (SELECT CAST(1 AS BLOB)), \
+                 p(y) AS MATERIALIZED (VALUES(X'31'),('1'),(1),(NULL)) \
+                 SELECT count(*) FROM p WHERE EXISTS(SELECT 1 FROM c WHERE c.x=p.y)",
+            ] {
+                let expected: i64 = stock.query_row(sql, [], |row| row.get(0)).unwrap();
+                assert_eq!(count(&conn, sql).await, expected, "{sql}");
+            }
+            assert!(!conn.memdb_rows_loaded.get());
+        });
+    }
